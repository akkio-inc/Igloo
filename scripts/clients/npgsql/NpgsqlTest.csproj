<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks Igloo through Npgsql, which Power BI's PostgreSQL connector
       uses. NpgsqlVersion picks the driver: Power BI Desktop bundles a 4.x
       release; current applications use the latest. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <NpgsqlVersion Condition="'$(NpgsqlVersion)' == ''">10.0.3</NpgsqlVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="$(NpgsqlVersion)" />
  </ItemGroup>
</Project>
