{
  "name": "igloo-site",
  "private": true,
  "type": "module",
  "description": "Igloo's website and documentation, built from the repository's markdown",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/sync-docs.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-links.mjs",
    "check-links": "node scripts/check-links.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/figtree": "5.3.0",
    "astro": "7.3.8",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "sharp": "0.35.5"
  }
}
