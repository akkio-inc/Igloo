---
import '@fontsource-variable/inter/opsz.css';
import '../styles/landing.css';
import AI from '../components/landing/AI.astro';
import Benchmark from '../components/landing/Benchmark.astro';
import Closing from '../components/landing/Closing.astro';
import Deploy from '../components/landing/Deploy.astro';
import Features from '../components/landing/Features.astro';
import Footer from '../components/landing/Footer.astro';
import Header from '../components/landing/Header.astro';
import Hero from '../components/landing/Hero.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Pillars from '../components/landing/Pillars.astro';
import QuickStart from '../components/landing/QuickStart.astro';
import Migrate from '../components/landing/Migrate.astro';
import Screens from '../components/landing/Screens.astro';
import { ANALYTICS, SHARE, SITE_PUBLIC, siteUrl } from '../site-config.mjs';

const { title, description, imageAlt } = SHARE;
const image = siteUrl(SHARE.image);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Structured data, so search results can describe Igloo as free, open source software.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Igloo',
	description,
	applicationCategory: 'DeveloperApplication',
	applicationSubCategory: 'SQL data warehouse',
	operatingSystem: 'Linux, macOS, Windows, Kubernetes',
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	isAccessibleForFree: true,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	image,
	...(canonical ? { url: canonical } : {}),
};
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{!SITE_PUBLIC && <meta name="robots" content="noindex, nofollow" />}
		{ANALYTICS && <script is:inline type="module" src={ANALYTICS.src} data-cf-beacon={ANALYTICS.beacon} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#08090d" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Igloo" />
		<meta property="og:locale" content="en_US" />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<Hero />
			<Pillars />
			<Benchmark />
			<AI />
			<Screens />
			<Migrate />
			<Features />
			<HowItWorks />
			<QuickStart />
			<Deploy />
			<Closing />
		</main>
		<Footer />
	</body>
</html>
