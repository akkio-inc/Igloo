---
import Icon from './Icon.astro';

// The README's benchmark summary, figure for figure. Do not add claims here
// that README.md and bench/README.md do not make.
const results = [
	{
		scale: 'Scale factor 10 (10 GB)',
		machine: 'One 16-core machine',
		faster: '4.3–6.8×',
		cheaper: '26–35×',
		against: 'than a Snowflake X-Small (Gen1 or Gen2) or Databricks SQL Serverless 2X-Small warehouse',
		cores: 16,
		layers: 2,
	},
	{
		scale: 'Scale factor 100',
		machine: 'The same machine',
		faster: '2.2–3.2×',
		cheaper: '10–16×',
		against: 'than those warehouses',
		cores: 16,
		layers: 6,
	},
	{
		scale: 'Scale factor 100',
		machine: 'A 64-core machine',
		faster: '2.4–3.2×',
		cheaper: '59–69×',
		against: 'than their X-Large sizes',
		cores: 64,
		layers: 6,
	},
];

// A small isometric line drawing of each run: the machine as a slab with
// one square per core on top, over one plate per slice of data.
const C = Math.cos(Math.PI / 6);
const at = (x: number, y: number, z: number) => `${((x - y) * C).toFixed(1)},${((x + y) * 0.5 - z).toFixed(1)}`;
const quad = (cls: string, pts: [number, number, number][]) =>
	`<polygon class="${cls}" points="${pts.map((p) => at(...p)).join(' ')}"/>`;
const slab = (size: number, zb: number, zt: number, topClass = 'face') =>
	quad('face', [
		[size, 0, zt],
		[size, size, zt],
		[size, size, zb],
		[size, 0, zb],
	]) +
	quad('face', [
		[0, size, zt],
		[size, size, zt],
		[size, size, zb],
		[0, size, zb],
	]) +
	quad(topClass, [
		[0, 0, zt],
		[size, 0, zt],
		[size, size, zt],
		[0, size, zt],
	]);
const drawing = (cores: number, layers: number) => {
	const size = 120;
	const plate = 5;
	const step = 12;
	const top = 14;
	let svg = '';
	for (let i = 0; i < layers; i++) svg += slab(size, i * step, i * step + plate);
	const zb = layers * step;
	const zt = zb + top;
	svg += slab(size, zb, zt, 'face face-top');
	const n = Math.sqrt(cores);
	const margin = 14;
	const gap = n > 4 ? 4 : 6;
	const cell = (size - 2 * margin - (n - 1) * gap) / n;
	for (let r = 0; r < n; r++) {
		for (let c = 0; c < n; c++) {
			const x = margin + c * (cell + gap);
			const y = margin + r * (cell + gap);
			svg += quad('core', [
				[x, y, zt],
				[x + cell, y, zt],
				[x + cell, y + cell, zt],
				[x, y + cell, zt],
			]);
		}
	}
	const w = size * C;
	return `<svg viewBox="${(-w - 2).toFixed(1)} ${-zt - 2} ${(2 * w + 4).toFixed(1)} ${size + zt + 4}" aria-hidden="true">${svg}</svg>`;
};
---

<section class="section section-alt" id="benchmark" aria-labelledby="bench-title">
	<div class="container">
		<div class="section-head">
			<span class="eyebrow">Benchmark</span>
			<h2 id="bench-title" class="headline">Price-performance on TPC-H</h2>
			<p>
				The 22 TPC-H queries with tables in Amazon S3, against Snowflake and Databricks on the same data and queries:
				speed, and cost per query at list prices. The margins vary with scale and size.
			</p>
		</div>
		<div class="results">
			{
				results.map((result) => (
					<div class="result surface">
						<div class="scale">{result.scale}</div>
						<div class="machine">{result.machine}</div>
						<div class="art" set:html={drawing(result.cores, result.layers)} />
						<dl>
							<div>
								<dt>faster</dt>
								<dd>{result.faster}</dd>
							</div>
							<div>
								<dt>cheaper</dt>
								<dd>{result.cheaper}</dd>
							</div>
						</dl>
						<p>{result.against}</p>
					</div>
				))
			}
		</div>
		<a class="more-link" href="/docs/benchmark/">
			The method, every result and its caveats <Icon name="arrow" size={16} />
		</a>
	</div>
</section>

<style>
	section.section {
		padding: 82px 0 54px;
	}
	.section .section-head {
		margin-bottom: 26px;
	}
	.section .section-head p {
		max-width: 850px;
	}
	.results {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 40px;
		margin-bottom: 26px;
	}
	@media (min-width: 1360px) {
		.results {
			margin-inline: -8.5px;
		}
	}
	/* A hairline down the middle of each gap between cards. */
	.result + .result::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: -21px;
		border-left: 1px solid var(--rule-strong);
	}
	.result {
		display: flex;
		flex-direction: column;
		padding: 32px 32px 19px;
	}
	.scale {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.machine {
		margin-top: 1px;
		font-size: 1.125rem;
		font-weight: 500;
		color: var(--heading);
	}
	.art {
		height: 140px;
		margin: 14px 0 16px;
		color: var(--line);
	}
	.art :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.art :global(.face) {
		fill: var(--bg-raised);
		stroke: currentColor;
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.art :global(.face-top) {
		stroke: color-mix(in srgb, var(--heading) 45%, transparent);
	}
	.art :global(.core) {
		fill: rgb(245 180 74 / 0.1);
		stroke: rgb(245 180 74 / 0.6);
		stroke-width: 0.75;
	}
	:global(:root[data-theme='light']) .art :global(.core) {
		fill: rgb(245 180 74 / 0.12);
		stroke: rgb(176 104 0 / 0.55);
	}
	dl {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin: 0;
		padding-top: 18px;
		border-top: 1px solid var(--rule);
	}
	dl div {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
	}
	dl div + div {
		padding-left: 24px;
		border-left: 1px solid var(--rule);
	}
	dt {
		margin-top: 0;
		font-size: 0.9375rem;
		color: var(--muted);
	}
	dd {
		margin: 0;
		font-size: clamp(1.75rem, 1.1rem + 1.3vw, 2.5rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.1;
		color: var(--heading);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	dl div:last-child dd {
		color: var(--amber);
	}
	.result p {
		margin: 21px 0 0;
		font-size: 0.9375rem;
		line-height: 1.4;
		color: var(--muted);
	}
	/* Three narrow cards: stack each card's two figures. */
	@media (min-width: 901px) and (max-width: 1180px) {
		dl {
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
		}
		dl div + div {
			padding-left: 0;
			border-left: 0;
		}
	}
	@media (max-width: 900px) {
		.results {
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
		}
		.result + .result::before {
			display: none;
		}
		.art {
			height: 170px;
		}
	}
	@media (max-width: 420px) {
		.result {
			padding: 24px 20px 28px;
		}
	}
</style>
