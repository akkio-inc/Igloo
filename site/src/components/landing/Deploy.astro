---
import { REPO_URL } from '../../docs-manifest.mjs';
import Icon from './Icon.astro';

// The README's "Deploy" table.
const targets = [
	{
		icon: 'box',
		title: 'One machine',
		text: 'Laptop, VM or on-prem server, with Docker Compose: make up',
		href: `${REPO_URL}/blob/main/deploy/single-vm/docker-compose.yml`,
		link: 'deploy/single-vm',
	},
	{ icon: 'hexagon', title: 'Any Kubernetes cluster', text: 'The Helm chart', href: '/docs/deploy/helm/', link: 'Helm chart' },
	{ icon: 'cloud', title: 'AWS', text: 'EKS, S3, RDS', href: '/docs/deploy/aws/', link: 'OpenTofu module' },
	{ icon: 'cloud', title: 'Google Cloud', text: 'GKE, GCS, Cloud SQL', href: '/docs/deploy/gcp/', link: 'OpenTofu module' },
	{
		icon: 'cloud',
		title: 'Azure',
		text: 'AKS, ADLS Gen2, PostgreSQL Flexible Server',
		href: '/docs/deploy/azure/',
		link: 'OpenTofu module',
	},
] as const;
---

<section class="section section-alt" id="deploy" aria-labelledby="deploy-title">
	<div class="container">
		<div class="section-head">
			<span class="eyebrow">Deploy</span>
			<h2 id="deploy-title">Runs anywhere</h2>
			<p>
				In your own cloud account or on your own hardware: Docker Compose for one machine, a Helm chart for any Kubernetes
				cluster, and OpenTofu modules that stand up the whole stack on AWS, Google Cloud or Azure.
			</p>
		</div>
		<div class="targets">
			{
				targets.map((target) => (
					<a class="target card" href={target.href}>
						<span class="icon">
							<Icon name={target.icon} size={22} />
						</span>
						<h3>{target.title}</h3>
						<p>{target.text}</p>
						<span class="link">
							{target.link} <Icon name="arrow" size={15} />
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.targets {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 16px;
	}
	.target {
		display: flex;
		flex-direction: column;
		padding: 22px;
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			border-color 0.15s ease;
	}
	.target:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
	}
	.icon {
		display: inline-grid;
		place-items: center;
		width: 40px;
		height: 40px;
		margin-bottom: 16px;
		border-radius: 11px;
		background: var(--surface-2);
		color: var(--ice);
	}
	h3 {
		font-size: 1.0625rem;
		font-weight: 750;
	}
	p {
		margin: 6px 0 16px;
		font-size: 0.9375rem;
		color: var(--muted);
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: auto;
		font-size: 0.875rem;
		font-weight: 650;
		color: var(--link);
	}
	@media (max-width: 1080px) {
		.targets {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (max-width: 720px) {
		.targets {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 420px) {
		.targets {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
