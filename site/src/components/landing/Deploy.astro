---
import { REPO_URL } from '../../docs-manifest.mjs';
import Icon from './Icon.astro';

// The README's "Deploy" table.
const targets = [
	{
		icon: 'box',
		title: 'One machine',
		text: 'Laptop, VM or on-prem server, with Docker Compose: make up',
		href: `${REPO_URL}/blob/main/deploy/single-vm/docker-compose.yml`,
		link: 'deploy/single-vm',
	},
	{ icon: 'hexagon', title: 'Any Kubernetes cluster', text: 'The Helm chart', href: '/docs/deploy/helm/', link: 'Helm chart' },
	{ icon: 'cloud', title: 'AWS', text: 'EKS, S3, RDS', href: '/docs/deploy/aws/', link: 'OpenTofu module' },
	{ icon: 'cloud', title: 'Google Cloud', text: 'GKE, GCS, Cloud SQL', href: '/docs/deploy/gcp/', link: 'OpenTofu module' },
	{
		icon: 'cloud',
		title: 'Azure',
		text: 'AKS, ADLS Gen2, PostgreSQL Flexible Server',
		href: '/docs/deploy/azure/',
		link: 'OpenTofu module',
	},
] as const;
---

<section class="section section-alt railed" id="deploy" aria-labelledby="deploy-title">
	<div class="container">
		<div class="section-head">
			<span class="eyebrow">Deploy</span>
			<h2 id="deploy-title" class="headline">Runs anywhere</h2>
			<p>
				In your own cloud account or on your own hardware: Docker Compose for one machine, a Helm chart for any Kubernetes
				cluster, and OpenTofu modules that stand up the whole stack on AWS, Google Cloud or Azure.
			</p>
		</div>
		<div class="targets">
			{
				targets.map((target) => (
					<a class="target surface" href={target.href}>
						<span class="icon-box">
							<Icon name={target.icon} size={22} />
						</span>
						<h3>{target.title}</h3>
						<p>{target.text}</p>
						<span class="link">
							{target.link} <Icon name="arrow" size={15} />
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.section.railed {
		padding-top: 87px;
		--rail-end: transparent;
		--section-glow:
			radial-gradient(760px 360px at 88% 260px, var(--glow-ice), transparent 70%),
			radial-gradient(560px 320px at 6% 600px, var(--glow-amber), transparent 70%);
	}
	.container {
		position: relative;
	}
	@media (min-width: 1360px) {
		.container::before {
			content: '';
			position: absolute;
			top: -28px;
			left: 555px;
			width: 479px;
			border-top: 1px solid transparent;
			border-image: linear-gradient(90deg, transparent, var(--rule) 25%, var(--rule) 75%, transparent) 1;
		}
	}
	.targets {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 16px;
	}
	.target {
		display: flex;
		flex-direction: column;
		padding: 28px 28px 32px;
		color: inherit;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}
	.target {
		--edge-right: rgb(200 214 232 / 0.16);
		--edge-bottom: rgb(200 214 232 / 0.1);
	}
	:global(:root[data-theme='light']) .target {
		--edge-right: rgb(13 20 38 / 0.1);
		--edge-bottom: rgb(13 20 38 / 0.15);
	}
	.target:hover {
		background: var(--surface-sheen), var(--surface-hover);
	}
	.icon-box {
		margin-bottom: 28px;
	}
	h3 {
		font-size: 1.1875rem;
		font-weight: 550;
		letter-spacing: -0.02em;
	}
	p {
		margin: 8px 0 28px;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: auto;
		font-size: 1rem;
		font-weight: 550;
		color: var(--link);
	}
	@media (max-width: 1080px) {
		.targets {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (max-width: 720px) {
		.targets {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.target {
			padding: 22px 20px 24px;
		}
	}
	@media (max-width: 420px) {
		.targets {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
