---
import Icon from './Icon.astro';

// The README's opening bullets, in its words.
const pillars = [
	{
		icon: 'terminal',
		title: 'Postgres-compatible',
		text: 'Clients connect over the PostgreSQL wire protocol, so <code>psql</code>, JDBC, psycopg, pgx, dbt, BI tools and notebooks work without an Igloo driver.',
		href: '/docs/sql/',
	},
	{
		icon: 'zap',
		title: 'Arrow-native extracts',
		text: 'Arrow Flight SQL streams results to pandas, polars, Spark and BI tools as Arrow record batches, through ADBC or the Flight SQL JDBC driver, several times faster than the PostgreSQL protocol.',
		href: '/docs/flight-sql/',
	},
	{
		icon: 'layers',
		title: 'Open table format',
		text: "Tables are Apache Iceberg in object storage (S3, GCS, Azure Data Lake Storage, or any S3-compatible store), with no proprietary storage to migrate out of. Spark, Trino and PyIceberg read and write them through Igloo's Iceberg REST catalog.",
		href: '/docs/external-engines/',
	},
	{
		icon: 'cpu',
		title: 'Fast on one machine, cheap to run',
		text: 'Queries run on an embedded DuckDB. Most analytical workloads fit on a single node; you pay for your own VMs and storage, nothing else.',
		href: '/docs/benchmark/',
	},
	{
		icon: 'cloud',
		title: 'Runs anywhere',
		text: 'Docker Compose for one machine, a Helm chart for any Kubernetes cluster, and OpenTofu modules that stand up the whole stack on AWS, Google Cloud or Azure.',
		href: '#deploy',
	},
	{
		icon: 'code',
		title: 'Open source',
		text: 'Licensed under Apache 2.0. Every component uses a permissive open-source license (Apache 2.0, MIT or the PostgreSQL License), except two libraries under the LGPL 2.1 inside DuckDB\'s extensions.',
		href: '#how-it-works',
	},
] as const;
---

<section class="pillars" aria-labelledby="pillars-title">
	<div class="container">
		<h2 id="pillars-title" class="sr-only">Why Igloo</h2>
		<div class="grid">
			{
				pillars.map((pillar) => (
					<a class="pillar" href={pillar.href}>
						<span class="icon-box">
							<Icon name={pillar.icon} size={24} />
						</span>
						<h3>{pillar.title}</h3>
						<p set:html={pillar.text} />
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Six cells ruled by hairlines between them, with no boxes around. */
	.pillars {
		position: relative;
		padding: 72px 0 40px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.pillar {
		display: block;
		padding: 40px 40px 48px;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}
	.pillar:hover {
		background: linear-gradient(180deg, var(--surface-hover), transparent);
	}
	.pillar:hover h3 {
		color: var(--link);
	}
	.pillar:not(:nth-child(3n + 1)) {
		border-left: 1px solid var(--border);
	}
	.pillar:nth-child(n + 4) {
		border-top: 1px solid var(--border);
	}
	.icon-box {
		width: 56px;
		height: 56px;
		border-radius: 12px;
		margin-bottom: 32px;
	}
	h3 {
		font-size: 1.375rem;
		font-weight: 550;
		letter-spacing: -0.022em;
		transition: color 0.15s ease;
	}
	p {
		margin: 12px 0 0;
		color: var(--muted);
		font-size: 1.0625rem;
		line-height: 1.65;
	}
	p :global(code) {
		color: var(--heading);
	}
	/* Wide enough: let the cells' padding hang outside the column so their
	   text lines up with the headings below. */
	@media (min-width: 1360px) {
		.grid {
			margin-inline: -40px;
		}
	}
	@media (max-width: 959px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.pillar {
			padding: 32px 28px 40px;
		}
		.pillar:not(:nth-child(3n + 1)) {
			border-left: 0;
		}
		.pillar:nth-child(n + 4) {
			border-top: 0;
		}
		.pillar:nth-child(2n) {
			border-left: 1px solid var(--border);
		}
		.pillar:nth-child(n + 3) {
			border-top: 1px solid var(--border);
		}
	}
	@media (max-width: 600px) {
		.pillars {
			padding-top: 40px;
		}
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.pillar {
			padding: 32px 0 36px;
		}
		.pillar:nth-child(2n) {
			border-left: 0;
		}
		.pillar:nth-child(n + 2) {
			border-top: 1px solid var(--border);
		}
		.icon-box {
			width: 48px;
			height: 48px;
			margin-bottom: 24px;
		}
		h3 {
			font-size: 1.25rem;
		}
	}
</style>
