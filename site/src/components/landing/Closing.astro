---
import { REPO_URL } from '../../docs-manifest.mjs';
import Icon from './Icon.astro';
---

<section class="closing" aria-labelledby="closing-title">
	<div class="container">
		<div class="panel">
			<h2 id="closing-title" class="headline">Open source SQL warehouse on Apache Iceberg</h2>
			<p>Licensed under Apache 2.0. Runs in your own cloud account or on your own hardware.</p>
			<div class="actions">
				<a class="btn btn-primary" href="#quick-start">Get started <Icon name="arrow" /></a>
				<a class="btn btn-secondary" href="/docs/"><Icon name="book" /> Read the docs</a>
				<a class="btn btn-secondary" href={REPO_URL}><Icon name="github" /> GitHub</a>
			</div>
		</div>
	</div>
</section>

<style>
	/* No box: a large heading, a line and the three ways in, over a faint
	   glow. */
	.closing {
		position: relative;
		isolation: isolate;
		padding: 129px 0 83px;
	}
	.closing::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(229px 172px at calc(50% - 482px) 0, rgb(var(--glow-warm) / calc(0.12 * var(--glow-k))), transparent 70%);
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 28px);
		mask-image: linear-gradient(to bottom, transparent 0, #000 28px);
	}
	.panel {
		max-width: 900px;
	}
	/* .panel raises this above .headline's size (scoped selectors carry no
	   class weight). */
	.panel h2 {
		font-size: clamp(2.25rem, 1.1rem + 3.2vw, 4rem);
		line-height: 0.94;
	}
	p {
		margin: 10px 0 0;
		max-width: 660px;
		font-size: clamp(1.0625rem, 0.95rem + 0.3vw, 1.1875rem);
		line-height: 1.55;
		color: var(--muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 31px;
	}
	@media (max-width: 720px) {
		.closing {
			padding: 96px 0 104px;
		}
		.actions .btn {
			flex: 1 1 auto;
		}
	}
</style>
