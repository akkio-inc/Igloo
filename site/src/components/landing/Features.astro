---
import { Code } from '@astrojs/starlight/components';
import Icon from './Icon.astro';

// "What you get" from the README, grouped, in its words. Each links to the
// page that documents it.
const groups = [
	{
		icon: 'database',
		title: 'SQL and tables',
		items: [
			{
				title: 'Iceberg tables',
				text: 'CREATE TABLE, CREATE TABLE AS, INSERT, UPDATE, DELETE, MERGE, schemas, views, comments, and time travel.',
				href: '/docs/sql/',
			},
			{
				title: 'Zero-copy clones',
				text: 'A full copy of production to develop and test against, made in seconds without copying data; and Iceberg branches and tags.',
				href: '/docs/sql/#clones',
			},
			{
				title: 'Media analytics',
				text: 'HLL and theta sketches for deduplicated reach and audience overlap; geometry and H3 functions for DMA, zip code and store-radius reporting.',
				href: '/docs/media-analytics/',
			},
			{
				title: 'Connections to other databases',
				text: 'Query PostgreSQL, MySQL and Snowflake databases in place, read-only, and join them with Iceberg tables.',
				href: '/docs/federation/',
			},
		],
	},
	{
		icon: 'shield',
		title: 'Security and governance',
		items: [
			{
				title: 'Users, roles and grants',
				text: 'SCRAM-SHA-256 passwords, built-in roles, and custom roles with grants on schemas and tables, all managed in SQL.',
				href: '/docs/sql/#roles-and-grants',
			},
			{
				title: 'Single sign-on',
				text: 'Okta, Microsoft Entra ID, Google Workspace or any OpenID Connect provider; access tokens and service accounts.',
				href: '/docs/sso/',
			},
			{
				title: 'Row access and masking policies, and tags',
				text: "Show each team only its clients' rows, and mask identifiers for everyone not allowed to see them.",
				href: '/docs/security-policies/',
			},
			{
				title: 'Erasure of personal data',
				text: "For GDPR and CCPA requests: one statement deletes a person's rows from every table whose columns are tagged with their identifiers.",
				href: '/docs/privacy/',
			},
		],
	},
	{
		icon: 'activity',
		title: 'Data in and out',
		items: [
			{
				title: 'Loading and scheduling',
				text: 'COPY INTO, pipes that load new files as they land, tasks on a cron or interval schedule, and materialized views.',
				href: '/docs/loading/',
			},
			{
				title: 'Alerts and notifications',
				text: 'Alerts run a query on a schedule and notify Slack, Microsoft Teams, email and webhooks when it returns rows.',
				href: '/docs/alerts/',
			},
			{
				title: 'Delta Sharing',
				text: "Share tables with clients and partners through the open protocol, and query partners' shares as external tables.",
				href: '/docs/sharing/',
			},
			{
				title: 'Other engines',
				text: "Spark, Trino, PyIceberg, Databricks and Snowflake through an Iceberg REST catalog, under Igloo's grants.",
				href: '/docs/external-engines/',
			},
		],
	},
	{
		icon: 'chart',
		title: 'Operations',
		items: [
			{
				title: 'Data catalog',
				text: 'Search, owners and descriptions, size and freshness, usage and table-level lineage from the query history.',
				href: '/docs/catalog/',
			},
			{
				title: 'Workload management',
				text: 'Query tags, per-client usage and estimated cost, per-role limits, and compute pools.',
				href: '/docs/workload-management/',
			},
			{
				title: 'Scale to zero',
				text: "A small gateway stops Igloo's machines or pods when nobody uses them and starts them when a client connects.",
				href: '/docs/scale-to-zero/',
			},
			{
				title: 'Distributed execution',
				text: 'A query over a very large table runs in parts on worker machines that Igloo starts when it needs them.',
				href: '/docs/distributed-execution/',
			},
		],
	},
] as const;

// Examples from the README, one per tab.
const examples = [
	{
		id: 'clones',
		label: 'Clones',
		href: '/docs/sql/#clones',
		code: `CREATE OR REPLACE SCHEMA dbt_ana CLONE analytics;
CREATE TABLE dev.orders CLONE prod.orders AT (TIMESTAMP => now() - INTERVAL 1 DAY);
ALTER TABLE prod.orders CREATE TAG q3_close;`,
	},
	{
		id: 'policies',
		label: 'Policies',
		href: '/docs/security-policies/',
		code: `CREATE ROW ACCESS POLICY client_rows AS (cid VARCHAR) RETURNS BOOLEAN ->
  EXISTS (SELECT 1 FROM governance.client_access a
          WHERE a.client_id = cid AND is_role_in_session(a.role_name));
ALTER TABLE marts.impressions ADD ROW ACCESS POLICY client_rows ON (client_id);
CREATE MASKING POLICY mask_pii AS (val VARCHAR) RETURNS VARCHAR ->
  CASE WHEN is_role_in_session('pii_reader') THEN val ELSE sha256(val) END;
CREATE TAG pii ALLOWED_VALUES 'email', 'device_id';
ALTER TAG pii SET MASKING POLICY mask_pii;
ALTER TABLE marts.impressions ALTER COLUMN email SET TAG pii = 'email';`,
	},
	{
		id: 'sharing',
		label: 'Sharing',
		href: '/docs/sharing/',
		code: `CREATE SHARE acme_reporting;
ALTER SHARE acme_reporting ADD TABLE marts.campaign_daily;
CREATE RECIPIENT acme;                       -- returns a one-time activation link
GRANT SELECT ON SHARE acme_reporting TO RECIPIENT acme;
CREATE EXTERNAL TABLE partners.viewership FROM SHARE tvco_ads.tv.viewing.daily;`,
	},
	{
		id: 'loading',
		label: 'Loading',
		href: '/docs/loading/',
		code: `COPY INTO sales FROM 's3://drops/sales/' (FORMAT csv, PATTERN '.*[.]csv[.]gz');
CREATE TASK nightly SCHEDULE '0 6 * * *' TIMEZONE 'America/New_York' AS
  CREATE OR REPLACE TABLE report AS SELECT day, sum(spend) FROM sales GROUP BY day;`,
	},
	{
		id: 'alerts',
		label: 'Alerts',
		href: '/docs/alerts/',
		code: `CREATE NOTIFICATION INTEGRATION ops_slack TYPE slack URL 'https://hooks.slack.com/services/...'
  OPERATIONAL_ALERTS = (FAILED_RUNS, IDLE_PIPES = 26);
GRANT USAGE ON INTEGRATION ops_slack TO ROLE analysts;
CREATE ALERT pacing SCHEDULE '0 9 * * MON-FRI' IF (EXISTS (
    SELECT campaign FROM marts.pacing WHERE abs(spend / planned - 1) > 0.2))
  THEN NOTIFY ops_slack MESSAGE 'Pacing is off plan for {{campaign}}' WITH RESULT;`,
	},
	{
		id: 'erasure',
		label: 'Erasure',
		href: '/docs/privacy/',
		code: `GRANT ERASE ON ACCOUNT TO privacy_officer;
ERASE SUBJECT WHERE pii.email = 'ann@example.com' OR pii.device_id = '6F9619FF-8B86-D011-B42D-00C04FC964FF';
SELECT status, verification FROM igloo.erasure_requests;
ALTER TABLE marts.impressions SET (data_retention_days = 30);`,
	},
];
---

<section class="section section-alt" id="features" aria-labelledby="features-title">
	<div class="container">
		<div class="section-head">
			<span class="eyebrow">Features</span>
			<h2 id="features-title" class="headline">What you get</h2>
			<p>
				Tables, governance, loading, sharing and operations, each linked to its documentation. What 1.0 does not do yet
				is listed under <a href="/docs/#limitations-in-10">Limitations in 1.0</a>.
			</p>
		</div>

		<div class="bento">
			{
				groups.map((group, i) => (
					<div class:list={['tile', 'surface', `tile-${i}`]}>
						<h3>
							<span class="icon">
								<Icon name={group.icon} size={28} />
							</span>
							{group.title}
						</h3>

						{/* A small picture of each group, drawn from the README and docs. */}
						{i === 0 && (
							<pre class="frag frag-code" aria-hidden="true"><span class="k">CREATE TABLE</span> dev.orders <span class="k">CLONE</span> prod.orders{'\n'}  <span class="k">AT</span> (<span class="k">TIMESTAMP</span> =&gt; now() - <span class="k">INTERVAL</span> <span class="n">1</span> <span class="k">DAY</span>);</pre>
						)}
						{i === 1 && (
							<div class="frag frag-mask" aria-hidden="true">
								<div class="frag-row frag-head">
									<span>role in session</span>
									<span>email</span>
								</div>
								<div class="frag-row">
									<span class="chip">pii_reader</span>
									<code>ann@example.com</code>
								</div>
								<div class="frag-row">
									<span class="chip">analyst</span>
									<code class="masked">sha256(email)</code>
								</div>
							</div>
						)}
						{i === 2 && (
							<div class="frag frag-lineage" aria-hidden="true">
								<div class="sources">
									<span class="chip">raw.campaigns</span>
									<span class="chip">raw.impressions</span>
								</div>
								<span class="arrow" />
								<span class="chip chip-hot">media.delivery</span>
							</div>
						)}
						{i === 3 && (
							<div class="frag frag-ops" aria-hidden="true">
								<code>SET query_tag = 'client:acme'</code>
								<code>ALTER ROLE analysts SET max_concurrent_statements = 4</code>
							</div>
						)}

						<ul>
							{group.items.map((item) => (
								<li>
									<a href={item.href}>{item.title}</a>
									<p>{item.text}</p>
								</li>
							))}
						</ul>
					</div>
				))
			}

			<igloo-sql-tabs class="tile tile-sql surface">
				<div class="showcase-head">
					<h3>
						<span class="icon">
							<Icon name="code" size={28} />
						</span>
						In SQL
					</h3>
					<div class="tabs" role="tablist" aria-label="SQL examples">
						{
							examples.map((example, i) => (
								<button
									type="button"
									role="tab"
									id={`sql-tab-${example.id}`}
									aria-controls={`sql-panel-${example.id}`}
									aria-selected={i === 0 ? 'true' : 'false'}
									tabindex={i === 0 ? 0 : -1}
								>
									{example.label}
								</button>
							))
						}
					</div>
				</div>
				{
					examples.map((example) => (
						<div
							class="sql-panel"
							role="tabpanel"
							id={`sql-panel-${example.id}`}
							aria-labelledby={`sql-tab-${example.id}`}
						>
							<Code code={example.code} lang="sql" />
							<a class="more-link" href={example.href}>
								Read the docs <Icon name="arrow" size={16} />
							</a>
						</div>
					))
				}
			</igloo-sql-tabs>
		</div>
	</div>
</section>

<script>
	class IglooSqlTabs extends HTMLElement {
		connectedCallback() {
			const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role=tab]')];
			const panels = [...this.querySelectorAll<HTMLElement>('[role=tabpanel]')];
			const select = (index: number, focus = false) => {
				tabs.forEach((tab, i) => {
					const selected = i === index;
					tab.setAttribute('aria-selected', String(selected));
					tab.tabIndex = selected ? 0 : -1;
					panels[i].hidden = !selected;
					if (selected && focus) tab.focus();
				});
			};
			tabs.forEach((tab, i) => {
				tab.addEventListener('click', () => select(i));
				tab.addEventListener('keydown', (event) => {
					const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
					if (!step) return;
					event.preventDefault();
					select((i + step + tabs.length) % tabs.length, true);
				});
			});
			select(0);
		}
	}
	customElements.define('igloo-sql-tabs', IglooSqlTabs);
</script>


<style>
	/* A bento grid: SQL wide, governance tall, then data and operations, and
	   the SQL examples across the bottom. */
	.bento {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-template-areas:
			'a a b'
			'c d b'
			'e e e';
		gap: 16px;
	}
	.tile {
		padding: 32px 32px 36px;
		container-type: inline-size;
	}
	.tile-0 {
		grid-area: a;
	}
	.tile-1 {
		grid-area: b;
	}
	.tile-2 {
		grid-area: c;
	}
	.tile-3 {
		grid-area: d;
	}
	.tile-sql {
		grid-area: e;
		display: block;
	}
	.tile-0 ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 40px;
	}
	.tile-0 li + li {
		margin-top: 0;
	}
	.tile-0 li:nth-child(n + 3) {
		margin-top: 20px;
		padding-top: 20px;
		border-top: 1px solid var(--border);
	}
	.tile-0 li:nth-child(2) {
		padding-top: 0;
		border-top: 0;
	}

	h3 {
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 1.375rem;
		font-weight: 550;
		letter-spacing: -0.022em;
	}
	.icon {
		display: inline-grid;
		place-items: center;
		color: var(--ice);
	}

	/* The small pictures. */
	.frag {
		margin: 28px 0 8px;
		padding: 14px 16px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--inset);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--text);
	}
	.frag-code {
		overflow-x: auto;
		white-space: pre;
	}
	.frag-code .k {
		color: var(--ice);
	}
	.frag-code .n {
		color: var(--amber);
	}
	.chip {
		display: inline-block;
		padding: 3px 12px;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--heading);
		white-space: nowrap;
	}
	.chip-hot {
		border-color: rgb(245 180 74 / 0.6);
		background: rgb(245 180 74 / 0.1);
		box-shadow: 0 0 14px -4px rgb(245 180 74 / 0.45);
	}
	.frag-mask {
		display: grid;
		gap: 10px;
		font-family: var(--font);
	}
	.frag-row {
		display: grid;
		grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
		align-items: center;
		gap: 14px;
	}
	.frag-mask .chip {
		width: 100%;
	}
	.frag-head {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
	}
	.frag-mask code {
		font-size: 0.875rem;
		color: var(--heading);
		overflow-wrap: anywhere;
	}
	.frag-mask code.masked {
		color: var(--amber);
	}
	.frag-lineage {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font);
	}
	.frag-lineage .chip {
		padding: 2px 9px;
		font-size: 0.75rem;
	}
	.sources {
		display: grid;
		gap: 8px;
	}
	.arrow {
		position: relative;
		flex: 1;
		min-width: 16px;
		border-top: 1px dashed var(--line);
	}
	.arrow::after {
		content: '';
		position: absolute;
		right: -1px;
		top: -5px;
		border: 5px solid transparent;
		border-left: 7px solid var(--line);
		border-right: 0;
	}
	/* Too narrow for sources, arrow and table in a row: stack them. */
	@container (max-width: 318px) {
		.frag-lineage {
			flex-direction: column;
			align-items: flex-start;
		}
		.sources {
			display: flex;
			flex-wrap: wrap;
		}
		.arrow {
			flex: none;
			min-width: 0;
			height: 16px;
			margin-left: 24px;
			border-top: 0;
			border-left: 1px dashed var(--line);
		}
		.arrow::after {
			right: auto;
			top: auto;
			left: -6px;
			bottom: -1px;
			border: 5px solid transparent;
			border-top: 7px solid var(--line);
			border-bottom: 0;
		}
	}
	.frag-ops {
		display: grid;
		gap: 6px;
	}
	.frag-ops code {
		font-size: 0.8125rem;
		color: var(--heading);
		overflow-wrap: anywhere;
	}

	ul {
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
	}
	li + li {
		margin-top: 20px;
		padding-top: 20px;
		border-top: 1px solid var(--border);
	}
	li a {
		font-size: 1.0625rem;
		font-weight: 550;
		color: var(--heading);
		text-decoration: none;
		letter-spacing: -0.012em;
	}
	li a:hover {
		color: var(--link);
		text-decoration: underline;
	}
	li p {
		margin: 6px 0 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.showcase-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 24px;
	}
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 2px;
		padding: 4px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
	}
	.tabs button {
		padding: 6px 16px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
	}
	.tabs button:hover {
		color: var(--heading);
	}
	.tabs button[aria-selected='true'] {
		background: var(--surface-2);
		color: var(--heading);
		box-shadow: 0 0 0 1px var(--border-strong);
	}
	igloo-sql-tabs:not(:defined) .tabs {
		display: none;
	}
	.sql-panel .more-link {
		margin-top: 20px;
	}
	igloo-sql-tabs:not(:defined) .sql-panel + .sql-panel {
		margin-top: 24px;
	}

	@media (max-width: 1080px) {
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-areas:
				'a a'
				'b c'
				'd d'
				'e e';
		}
	}
	@media (max-width: 700px) {
		.bento {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'a' 'b' 'c' 'd' 'e';
		}
		.tile {
			padding: 24px 20px 28px;
		}
		h3 {
			font-size: 1.25rem;
		}
		.tile-0 ul {
			grid-template-columns: minmax(0, 1fr);
		}
		.tile-0 li:nth-child(2) {
			margin-top: 20px;
			padding-top: 20px;
			border-top: 1px solid var(--border);
		}
		.frag {
			padding: 14px 14px;
		}
		.frag-row {
			grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
			gap: 10px;
		}
	}
</style>
