---
// The README's quick start, rendered from README.md at build time.
import { Code } from '@astrojs/starlight/components';
import { Content as Steps } from '../../generated/quick-start.md';
import { REPO_URL } from '../../docs-manifest.mjs';
import Icon from './Icon.astro';
---

<section class="section railed" id="quick-start" aria-labelledby="quick-title">
	<div class="container layout">
		<div class="intro">
			<span class="eyebrow">Get started</span>
			<h2 id="quick-title" class="headline">Quick start</h2>
			<p>Clone the repository, then start the single-machine stack with Docker Compose.</p>
			<Code code={`git clone ${REPO_URL}.git\ncd Igloo`} lang="sh" />
			<ul class="next">
				<li>
					<a href="/docs/"><Icon name="book" size={18} /> Read the docs</a>
				</li>
				<li>
					<a href="/docs/configuration/"><Icon name="terminal" size={18} /> Every setting</a>
				</li>
				<li>
					<a href="#deploy"><Icon name="cloud" size={18} /> Deploy to Kubernetes or the cloud</a>
				</li>
			</ul>
		</div>
		<div class="prose steps surface">
			<Steps />
		</div>
	</div>
</section>

<style>
	.section {
		padding-bottom: 72px;
	}
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 382fr) minmax(0, 762fr);
		gap: 56px;
		align-items: start;
	}
	.intro {
		position: sticky;
		top: calc(var(--header-h) + 32px);
	}
	.steps {
		padding: 36px;
		border-radius: 16px;
		font-size: 1.0625rem;
		line-height: 1.65;
	}
	.intro > p {
		margin: 20px 0 28px;
		font-size: clamp(1.0625rem, 0.95rem + 0.35vw, 1.25rem);
		line-height: 1.55;
		color: var(--muted);
	}
	.next {
		margin: 36px 0 0;
		padding: 0;
		list-style: none;
	}
	.next li + li {
		margin-top: 14px;
	}
	.next a {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-weight: 500;
		font-size: 1.0625rem;
		text-decoration: none;
	}
	.next a:hover {
		text-decoration: underline;
	}
	@media (max-width: 900px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}
		.intro {
			position: static;
		}
		.steps {
			padding: 20px 16px;
			font-size: 1rem;
		}
	}
</style>
