---
// The README's "How it works" diagram, drawn in HTML so it reflows on phones,
// followed by the README's own description of each part.
import { Content as Description } from '../../generated/how-it-works.md';
import Icon from './Icon.astro';

const clients = [
	{ title: 'psql · JDBC · BI tools', via: 'PostgreSQL wire protocol', detail: 'SCRAM, optional TLS', icon: 'database' },
	{
		title: 'pandas · polars · Spark (ADBC) · Flight JDBC',
		via: 'Arrow Flight SQL',
		detail: 'TLS, or localhost only',
		icon: 'swap',
	},
	{ title: 'Spark · Trino · PyIceberg · Databricks · Snowflake', via: 'Iceberg REST', detail: 'port 8181', icon: 'box' },
] as const;

const backends = [
	{ title: 'Object storage', sub: 'S3, GCS, ADLS, S3-compatible', via: 'Parquet data and Iceberg metadata', icon: 'bucket', viaIcon: 'file' },
	{ title: 'Lakekeeper', sub: 'Iceberg REST catalog', via: 'Iceberg REST', icon: 'server', viaIcon: 'box' },
	{
		title: 'PostgreSQL',
		sub: 'Catalog metadata, and users and roles (schema igloo_auth)',
		via: 'Users and roles',
		icon: 'database',
		viaIcon: 'users',
	},
] as const;
---

<section class="section" id="how-it-works" aria-labelledby="how-title">
	<div class="container">
		<div class="section-head">
			<span class="eyebrow">Architecture</span>
			<h2 id="how-title" class="headline">How it works</h2>
			<p>One Go server in front of an embedded DuckDB, with tables in Apache Iceberg on your object storage.</p>
		</div>

		<figure class="diagram surface" aria-label="Architecture diagram">
			<div class="row">
				{
					clients.map((client) => (
						<div class="cell">
							<div class="node client">{client.title}</div>
							<div class="edge">
								<span class="chip">
									<Icon name={client.icon} size={20} />
									<span>
										<strong>{client.via}</strong>
										{client.detail}
									</span>
								</span>
							</div>
						</div>
					))
				}
			</div>
			<div class="mobile-arrow" aria-hidden="true"></div>
			<div class="node igloo">
				<span class="igloo-name">igloo</span>
				<span class="igloo-sub">1..n replicas · DuckDB inside · users, roles and grants checked on every statement</span>
			</div>
			<div class="mobile-arrow" aria-hidden="true"></div>
			<div class="row">
				{
					backends.map((backend, i) => (
						<div class="cell">
							<div class="edge">
								<span class="chip">
									<Icon name={backend.viaIcon} size={18} />
									<span>
										<strong>{backend.via}</strong>
									</span>
								</span>
							</div>
							<div class:list={['node', 'backend', { 'feeds-next': i === 1 }]}>
								<Icon name={backend.icon} size={30} class="backend-icon" />
								<span class="backend-text">
									<span class="backend-title">{backend.title}</span>
									<span class="backend-sub">{backend.sub}</span>
								</span>
							</div>
						</div>
					))
				}
			</div>
		</figure>

		<div class="prose description">
			<Description />
		</div>
	</div>
</section>

<style>
	section.section {
		padding: 71px 0 63px;
	}
	.diagram {
		margin: 0 3px;
		padding: 32px 35px 36px;
		border-radius: 16px;
	}
	.row {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}
	.cell {
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}
	.node {
		border: 1px solid;
		border-color: var(--edge-top) var(--edge-side) var(--edge-bottom);
		border-radius: 10px;
		background: var(--bg-raised);
		color: var(--heading);
	}
	.client {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 87px;
		padding: 16px 20px;
		font-size: 1.0625rem;
		font-weight: 550;
		text-align: center;
		text-wrap: balance;
	}
	.edge {
		position: relative;
		display: flex;
		justify-content: center;
		padding: 24.5px 0;
	}
	.row:last-child .edge {
		padding: 27px 0;
	}
	/* A thin vertical line ending in an arrowhead, its label on a chip
	   over the line. */
	.edge::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 5px;
		left: 50%;
		border-left: 1px solid var(--line);
	}
	.edge::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: calc(50% - 4px);
		border: 4px solid transparent;
		border-top: 6px solid var(--line);
		border-bottom: 0;
	}
	.chip {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 14px;
		padding: 8px 18px 8px 14px;
		border-radius: 10px;
		background: var(--bg-raised);
		border: 1px solid;
		border-color: var(--rule-strong) var(--edge-side) var(--edge-bottom);
		font-size: 0.875rem;
		line-height: 1.4;
		color: var(--muted);
	}
	.chip :global(svg) {
		flex: none;
		color: var(--ice);
	}
	.chip strong {
		display: block;
		color: var(--heading);
		font-weight: 500;
	}
	.igloo {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		padding: 18px 24px;
		text-align: center;
		border-color: color-mix(in srgb, var(--amber-fill-2) 75%, transparent);
		box-shadow:
			0 0 0 3px color-mix(in srgb, var(--amber-fill-2) 8%, transparent),
			0 0 40px -10px color-mix(in srgb, var(--amber-fill-2) 45%, transparent),
			inset 0 0 32px -12px color-mix(in srgb, var(--amber-fill-2) 25%, transparent);
	}
	.igloo-name {
		font-family: var(--font-mono);
		font-size: 1.5rem;
		font-weight: 700;
	}
	.igloo-sub {
		color: var(--muted);
		font-size: 1rem;
	}
	.backend {
		position: relative;
		flex: 1;
		display: flex;
		align-items: center;
		gap: 20px;
		padding: 15.5px 24px;
	}
	.backend :global(.backend-icon) {
		flex: none;
		color: var(--ice);
	}
	.backend-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.backend-title {
		font-size: 1.0625rem;
		font-weight: 550;
	}
	.backend-sub {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	/* Lakekeeper keeps its metadata in PostgreSQL. */
	.feeds-next::after {
		content: '';
		position: absolute;
		top: 50%;
		right: -21px;
		width: 20px;
		border-top: 1px solid var(--line);
	}

	.description {
		max-width: 1112px;
		margin-top: 44px;
		font-size: 1.2rem;
		line-height: 1.47;
	}
	.description :global(ul) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px clamp(40px, 10vw, 140px);
		padding: 0;
		list-style: none;
	}
	.description :global(li + li) {
		margin-top: 0;
	}
	.description > :global(p) {
		max-width: 1000px;
		color: var(--muted);
	}

	.mobile-arrow {
		display: none;
	}

	@media (max-width: 1080px) {
		.backend {
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}
	}
	@media (max-width: 860px) {
		.diagram {
			padding: 16px;
		}
		.row {
			grid-template-columns: minmax(0, 1fr);
			gap: 12px;
		}
		.client {
			min-height: 0;
		}
		/* No lines between stacked boxes: each box names its protocol, and one
		   arrow joins each row to igloo. */
		.edge {
			padding: 8px 0 0;
		}
		.row:last-child .edge {
			padding: 0 0 8px;
		}
		.edge::before,
		.edge::after,
		.feeds-next::after {
			display: none;
		}
		.chip {
			border: 0;
			padding: 0;
			background: transparent;
		}
		.backend {
			flex-direction: row;
			align-items: center;
		}
		.mobile-arrow {
			display: block;
			position: relative;
			height: 40px;
		}
		.mobile-arrow::before {
			content: '';
			position: absolute;
			top: 6px;
			bottom: 12px;
			left: 50%;
			border-left: 1px solid var(--line);
		}
		.mobile-arrow::after {
			content: '';
			position: absolute;
			bottom: 6px;
			left: calc(50% - 5px);
			border: 5px solid transparent;
			border-top: 7px solid var(--line);
			border-bottom: 0;
		}
		.description {
			font-size: 1.0625rem;
		}
		.description :global(ul) {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
