---
import { Image } from 'astro:assets';
import heroDark from '../../assets/hero-dark.png';
import heroLight from '../../assets/hero-light.png';
import { REPO_URL } from '../../docs-manifest.mjs';
import Icon from './Icon.astro';

// The README banners' illustration without their lettering, which is set in
// HTML here. It fills the hero, mirrored so the igloo sits on the right and
// its doorway faces the text.
const art = { widths: [640, 960, 1440, 1920, 2400], sizes: '100vw', format: 'webp', quality: 85 } as const;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-art" aria-hidden="true">
		<Image src={heroLight} alt="" class="theme-light" loading="eager" fetchpriority="high" {...art} />
		<Image src={heroDark} alt="" class="theme-dark" loading="eager" fetchpriority="high" {...art} />
	</div>
	<div class="container hero-inner">
		<div class="hero-copy">
			<h1 id="hero-title">Igloo</h1>
			<p class="tagline">Open source SQL warehouse on Apache Iceberg</p>
			<p class="claim"><span>5x faster</span> • <span>30x cheaper per query*</span></p>
			<p class="note">*at 10GB query scale, exact speedup and cost reduction will vary</p>
			<p class="lead">
				Igloo is an open-source SQL data warehouse that runs in your own cloud account or on your own hardware.
			</p>
			<div class="cta">
				<a class="btn btn-primary" href="#quick-start">Get started <Icon name="arrow" /></a>
				<a class="btn btn-secondary" href={REPO_URL}><Icon name="github" /> GitHub</a>
			</div>
			<p class="stack">Apache 2.0 · PostgreSQL wire protocol · DuckDB · Apache Iceberg</p>
		</div>
	</div>
</section>

<style>
	.hero {
		--hero-h: clamp(660px, 50vw, 820px);
		position: relative;
		display: flex;
		align-items: center;
		min-height: var(--hero-h);
		overflow: hidden;
		isolation: isolate;
		background: var(--bg);
	}

	/* The art fills the hero. Mirrored, the left of the picture (the igloo)
	   lands on the right; a scrim in the page's colour darkens the side the
	   text sits on and fades the bottom into the page. */
	.hero-art {
		position: absolute;
		z-index: -2;
		inset: 0;
	}
	.hero-art :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left 75%;
		transform: scaleX(-1);
	}
	.hero::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(
				90deg,
				rgb(var(--hero-scrim) / 0.97) 0%,
				rgb(var(--hero-scrim) / 0.9) 30%,
				rgb(var(--hero-scrim) / 0.55) 46%,
				rgb(var(--hero-scrim) / 0) 64%
			),
			linear-gradient(0deg, var(--bg) 0%, rgb(var(--hero-scrim) / 0) 24%),
			linear-gradient(180deg, rgb(var(--hero-scrim) / 0.55) 0%, rgb(var(--hero-scrim) / 0) 22%);
	}

	.hero-inner {
		padding-top: calc(var(--header-h) + 40px);
		padding-bottom: 56px;
	}
	.hero-copy {
		max-width: 640px;
	}

	h1 {
		font-size: clamp(4rem, 1.6rem + 5.6vw, 7.25rem);
		font-weight: 680;
		line-height: 0.95;
		letter-spacing: -0.06em;
		margin-left: -0.04em;
		background: var(--headline);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		padding-bottom: 0.1em;
	}
	.tagline {
		margin: 20px 0 0;
		font-size: clamp(1.25rem, 0.9rem + 0.85vw, 1.625rem);
		font-weight: 420;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--hero-text);
	}
	.claim {
		margin: 12px 0 0;
		font-size: clamp(1.5rem, 0.95rem + 1.35vw, 2.125rem);
		font-weight: 650;
		line-height: 1.2;
		letter-spacing: -0.03em;
		color: var(--hero-claim);
	}
	.claim span {
		white-space: nowrap;
	}
	.note {
		margin: 10px 0 0;
		font-size: 0.9375rem;
		color: var(--hero-note);
	}
	.lead {
		margin: 28px 0 0;
		max-width: 32em;
		font-size: clamp(1.0625rem, 0.95rem + 0.3vw, 1.1875rem);
		line-height: 1.6;
		color: var(--hero-text);
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 32px;
	}
	.stack {
		margin: 28px 0 0;
		padding-top: 24px;
		border-top: 1px solid var(--border);
		font-size: 0.9375rem;
		color: var(--hero-note);
	}

	/* Narrower screens: the illustration as a band on top, the text below. */
	@media (max-width: 1023px) {
		.hero {
			display: block;
			min-height: 0;
		}
		.hero-art {
			position: relative;
			inset: auto;
			z-index: -2;
			height: calc(var(--header-h) + clamp(260px, 52vw, 460px));
			-webkit-mask-image: linear-gradient(to top, transparent 0%, #000 30%);
			mask-image: linear-gradient(to top, transparent 0%, #000 30%);
		}
		.hero-art :global(img) {
			object-position: left 80%;
		}
		.hero::before {
			display: none;
		}
		.hero-inner {
			margin-top: -48px;
			padding-top: 0;
			padding-bottom: 72px;
		}
	}
	@media (max-width: 600px) {
		.hero-art {
			height: calc(var(--header-h) + 280px);
		}
		.hero-art :global(img) {
			object-position: 0% 80%;
		}
		.hero-inner {
			margin-top: -40px;
			padding-bottom: 32px;
		}
		.cta .btn {
			flex: 1 1 auto;
		}
	}
</style>
