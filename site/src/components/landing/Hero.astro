---
import { Image } from 'astro:assets';
import heroDark from '../../assets/hero-dark.png';
import heroLight from '../../assets/hero-light.png';
import { REPO_URL } from '../../docs-manifest.mjs';
import Icon from './Icon.astro';

// The README banners' illustration without their lettering, which is set in
// HTML here. Wide screens show all of it behind the text.
const art = { widths: [640, 960, 1440, 1920, 2400], sizes: '100vw', format: 'webp', quality: 85 } as const;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-art" aria-hidden="true">
		<Image src={heroLight} alt="" class="theme-light" loading="eager" fetchpriority="high" {...art} />
		<Image src={heroDark} alt="" class="theme-dark" loading="eager" fetchpriority="high" {...art} />
	</div>
	<div class="hero-inner">
		<div class="hero-copy glass glass-blur">
			<h1 id="hero-title">Igloo</h1>
			<p class="tagline">Open source SQL warehouse on Apache Iceberg</p>
			<p class="claim"><span>5x faster</span> • <span>30x cheaper per query*</span></p>
			<p class="note">*at 10GB query scale, exact speedup and cost reduction will vary</p>
			<p class="lead">
				Igloo is an open-source SQL data warehouse that runs in your own cloud account or on your own hardware.
			</p>
			<div class="cta">
				<a class="btn btn-primary" href="#quick-start">Get started <Icon name="arrow" /></a>
				<a class="btn btn-secondary" href={REPO_URL}><Icon name="github" /> GitHub</a>
			</div>
			<p class="stack">Apache 2.0 · PostgreSQL wire protocol · DuckDB · Apache Iceberg</p>
		</div>
	</div>
</section>

<style>
	.hero {
		--hero-h: clamp(600px, 44vw, 760px);
		/* The art covers the hero, anchored at its left edge, so it is drawn at
		   least as wide as the hero is high times its 3:1 shape. The igloo sits
		   in its left 40%, and the text starts past it. */
		--art-w: max(100vw, calc(var(--hero-h) * 3));
		--igloo-end: calc(var(--art-w) * 0.4);
		position: relative;
		min-height: var(--hero-h);
		background: var(--hero-sky);
		overflow: hidden;
		isolation: isolate;
	}

	.hero-art {
		position: absolute;
		z-index: -1;
		inset: 0;
		/* Fade the bottom into the page. */
		-webkit-mask-image: linear-gradient(to top, transparent 0%, #000 18%);
		mask-image: linear-gradient(to top, transparent 0%, #000 18%);
	}
	.hero-art :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left bottom;
	}

	.hero-inner {
		position: relative;
		display: flex;
		align-items: center;
		min-height: var(--hero-h);
		padding: var(--header-h) max(24px, calc((100vw - 1280px) / 2)) 48px calc(var(--igloo-end) - 40px);
	}
	/* The text sits on frosted glass over the art, which keeps it legible
	   over moonlit snow and bright sky alike. */
	.hero-copy {
		width: min(680px, 100%);
		padding: 40px 44px 36px;
		border-radius: 24px;
	}

	h1 {
		font-size: clamp(3.75rem, 2rem + 6vw, 6.5rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.055em;
		color: var(--hero-heading);
		background: var(--headline);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		padding-bottom: 0.06em;
	}
	.tagline {
		margin: 18px 0 0;
		font-size: clamp(1.25rem, 0.85rem + 0.8vw, 1.5rem);
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.02em;
		color: var(--hero-text);
	}
	.claim {
		margin: 14px 0 0;
		font-size: clamp(1.5rem, 1rem + 1.1vw, 1.875rem);
		font-weight: 680;
		line-height: 1.2;
		letter-spacing: -0.03em;
		color: var(--hero-claim);
	}
	.claim span {
		white-space: nowrap;
	}
	.note {
		margin: 8px 0 0;
		font-size: 0.9375rem;
		color: var(--hero-note);
	}
	.lead {
		margin: 24px 0 0;
		max-width: 34em;
		font-size: 1.125rem;
		color: var(--hero-text);
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}
	.stack {
		margin: 22px 0 0;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--hero-note);
	}
	.stack {
		padding-top: 20px;
		border-top: 1px solid var(--glass-border);
	}

	/* Narrower screens: the whole illustration on top, at its own 3:1 shape,
	   and the text below it. */
	@media (max-width: 1279px) {
		.hero {
			min-height: 0;
		}
		.hero-art {
			position: relative;
			inset: auto;
			width: 100%;
			aspect-ratio: 3 / 1;
			margin-top: var(--header-h);
			-webkit-mask-image: linear-gradient(to top, transparent 0%, #000 22%);
			mask-image: linear-gradient(to top, transparent 0%, #000 22%);
		}
		.hero-inner {
			min-height: 0;
			margin-top: -72px;
			padding: 0 24px 64px;
			justify-content: center;
		}
		.hero-copy {
			width: 100%;
			max-width: 720px;
		}
	}

	/* Phones: a 3:1 strip would be tiny, so show the igloo up close. */
	@media (max-width: 639px) {
		.hero-art {
			aspect-ratio: 16 / 10;
		}
		.hero-art :global(img) {
			object-position: 4% 80%;
		}
		.hero-inner {
			justify-content: flex-start;
			margin-top: -48px;
			padding-inline: 16px;
		}
		.hero-copy {
			padding: 28px 22px 24px;
			border-radius: 20px;
		}
	}
</style>
