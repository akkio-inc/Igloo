---
// A landing section rebuilt pixel for pixel from its design concept (an absolutely positioned canvas in
// the concept's own pixels, 1600 wide). It shows on wide screens in the dark theme, scaled to the window;
// narrower screens and the light theme get the responsive section passed in the slot. Each canvas lives in its
// own (declarative) shadow root, so the site's global CSS can't reach it and it renders as it did when fitted;
// inherited text settings are reset at the boundary for the same reason.
interface Props {
	html: string; // the section's fragment: one .rc canvas plus its scoped <style>
	width: number;
	height: number;
	label: string;
	replaces?: string; // "header" or "footer": the site component this canvas already contains
}
const { html, width, height, label, replaces = '' } = Astro.props;
const assets = import.meta.glob<{ src: string }>(['/src/assets/**/*.{png,jpg,jpeg,webp,svg}', '/src/generated/**/*.{png,jpg,jpeg,webp,svg}'], { eager: true, import: 'default' });
const resolved = html.replace(/\{\{asset:([^}]+)\}\}/g, (_, path: string) => {
	const key = '/' + path.replace(/^site\//, '');
	const asset = assets[key];
	if (!asset) throw new Error(`recreated section "${label}": no asset at ${path}`);
	return asset.src;
});
---

<section class="rc-wrap" aria-label={label} data-w={width} data-replaces={replaces} style={`--rc-w:${width};--rc-h:${height}`}>
	<div class="rc-scale"><template shadowrootmode="open" set:html={`<style>:host{all:initial;display:block}</style>${resolved}`} /></div>
</section>
<div class="rc-fallback"><slot /></div>

<style is:global>
	.rc-wrap {
		display: none;
		position: relative;
		width: 100%;
		overflow: hidden;
		height: calc(var(--rc-h) * var(--rc-s, 0.9) * 1px);
	}
	.rc-scale {
		position: absolute;
		left: 50%;
		top: 0;
		width: calc(var(--rc-w) * 1px);
		transform-origin: top center;
		transform: translateX(-50%) scale(var(--rc-s, 0.9));
	}
	@media (min-width: 1200px) {
		:root[data-theme='dark'] .rc-wrap {
			display: block;
		}
		:root[data-theme='dark'] .rc-fallback,
		:root[data-theme='dark'] body:has(.rc-wrap[data-replaces='header']) .site-header,
		:root[data-theme='dark'] body:has(.rc-wrap[data-replaces='footer']) .site-footer {
			display: none;
		}
	}
</style>

<script>
	// Scale every canvas to the window width (capped at 1920 px, then centred).
	const fit = () => {
		for (const el of document.querySelectorAll<HTMLElement>('.rc-wrap')) {
			const w = Number(el.dataset.w);
			el.style.setProperty('--rc-s', String(Math.min(document.documentElement.clientWidth, 1920) / w));
		}
	};
	fit();
	addEventListener('resize', fit);

	const canvases = () => [...document.querySelectorAll<HTMLElement>('.rc-scale')].flatMap((h) => (h.shadowRoot ? [h.shadowRoot] : []));
	const visible = (el: Element | null) => !!el && (el as HTMLElement).getClientRects().length > 0;

	// In-page links: when the target section is the hidden responsive one, go to the matching spot in its
	// canvas instead (an element tagged data-rc-anchor, else the canvas heading with that id, else the canvas).
	const resolveAnchor = (id: string): HTMLElement | null => {
		const el = document.getElementById(id);
		if (!el || visible(el)) return el;
		const wrap = el.closest('.rc-fallback')?.previousElementSibling as HTMLElement | null;
		if (!wrap?.classList.contains('rc-wrap') || !visible(wrap)) return el;
		const root = wrap.querySelector('.rc-scale')?.shadowRoot;
		return (
			root?.querySelector<HTMLElement>(`[data-rc-anchor="${id}"]`) ??
			root?.querySelector<HTMLElement>(`[id$="-${id}-title"], [id$="-${id}"], [id="${id}-title"]`) ??
			wrap
		);
	};
	addEventListener('click', (e) => {
		const a = e.composedPath().find((n): n is HTMLAnchorElement => n instanceof HTMLAnchorElement);
		const href = a?.getAttribute('href');
		if (!href?.startsWith('#') || href.length < 2) return;
		const id = href.slice(1);
		const target = resolveAnchor(id);
		if (target && target !== document.getElementById(id)) {
			e.preventDefault();
			target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
			history.pushState(null, '', `#${id}`);
		}
	});
	if (location.hash.length > 1) {
		const id = decodeURIComponent(location.hash.slice(1));
		const t = resolveAnchor(id);
		if (t && t !== document.getElementById(id)) t.scrollIntoView();
	}

	for (const root of canvases()) {
		// Tabs inside a canvas (data-rc-tab / data-rc-panel), as the responsive sections' tabs behave.
		for (const tab of root.querySelectorAll<HTMLElement>('[data-rc-tab]')) {
			tab.addEventListener('click', () => {
				const canvas = tab.closest('.rc') ?? root;
				for (const t of canvas.querySelectorAll<HTMLElement>('[data-rc-tab]')) {
					t.setAttribute('aria-selected', String(t === tab));
					t.tabIndex = t === tab ? 0 : -1;
				}
				for (const p of canvas.querySelectorAll<HTMLElement>('[data-rc-panel]')) p.hidden = p.dataset.rcPanel !== tab.dataset.rcTab;
			});
		}
		// The recreated hero carries its own theme button; it behaves like the site header's (same storage key as
		// Starlight). Switching to light hides the canvases and shows the responsive sections.
		for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			btn.addEventListener('click', () => {
				const html = document.documentElement;
				const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
				html.dataset.theme = next;
				try {
					localStorage.setItem('starlight-theme', next);
				} catch {}
				const label = `Switch to ${next === 'dark' ? 'light' : 'dark'} theme`;
				for (const b of document.querySelectorAll('[data-theme-toggle]')) b.setAttribute('aria-label', label);
				for (const r of canvases()) for (const b of r.querySelectorAll('[data-theme-toggle]')) b.setAttribute('aria-label', label);
			});
		}
	}
</script>
