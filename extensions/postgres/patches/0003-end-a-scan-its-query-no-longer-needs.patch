+		auto ready = PQsocketPoll(PQsocket(conn), 1, 0, PQgetCurrentTimeUSec() + CANCEL_AGAIN_USEC);
+		if (ready < 0 && errno == EINTR) {
+			// a signal the thread handled ended the wait early
+			continue;
+		}
+		if (ready < 0 || (ready > 0 && !PQconsumeInput(conn))) {
