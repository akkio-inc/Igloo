+// Igloo: a command in flight when the connection is wanted for another is a COPY whose reader the query has left
+// behind. libpq reads such a COPY to its end before it sends the next command, however long the server takes to send
+// it: the server is asked to cancel it instead, as psql does on Ctrl-C.
+
+//! How long a command may go on after the server was asked to cancel it, before it is asked again
+static constexpr pg_usec_time_t CANCEL_AGAIN_USEC = 1000000;
+
+static void RequestCancel(PGconn *conn) noexcept {
+	auto cancel = PQcancelCreate(conn);
+	if (!cancel) {
+		return;
+	}
+	PQcancelBlocking(cancel);
+	PQcancelFinish(cancel);
+}
+
+void PostgresConnection::EndCommand(bool cancel) noexcept {
+	if (!connection || !connection->connection) {
+		return;
+	}
+	auto conn = connection->connection;
+	if (PQtransactionStatus(conn) != PQTRANS_ACTIVE) {
+		// no command is in flight
+		return;
+	}
+	// The request goes to the server process of this connection alone. It is repeated each second the command goes
+	// on: one that reaches a server before the command does is lost.
+	pg_usec_time_t cancel_at = 0;
+	while (true) {
+		if (cancel && PQgetCurrentTimeUSec() >= cancel_at) {
+			RequestCancel(conn);
+			cancel_at = PQgetCurrentTimeUSec() + CANCEL_AGAIN_USEC;
+		}
+		if (!PQisBusy(conn)) {
+			auto res = PQgetResult(conn);
+			if (!res) {
+				// the command has ended
+				return;
+			}
+			auto status = PQresultStatus(res);
+			PQclear(res);
+			if (status == PGRES_COPY_IN || status == PGRES_COPY_BOTH) {
+				return;
+			}
+			if (status != PGRES_COPY_OUT) {
+				continue;
+			}
