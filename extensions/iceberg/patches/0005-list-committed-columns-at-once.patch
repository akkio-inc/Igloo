+//! Igloo: whether a commit of table changes what the catalog's listings (duckdb_columns(),
+//! information_schema, pg_catalog) show of it: its columns, which a new current schema changes, or its
+//! properties, which hold its comment.
+static bool ChangesListedTable(const IcebergTableInformation &table) {
+	if (!table.transaction_data) {
+		return false;
+	}
+	auto &transaction_data = *table.transaction_data;
+	if (transaction_data.set_schema_id) {
+		return true;
+	}
+	for (auto &update : transaction_data.updates) {
+		if (update->type == IcebergTableUpdateType::SET_PROPERTIES ||
+		    update->type == IcebergTableUpdateType::REMOVE_PROPERTIES) {
+			return true;
+		}
+	}
+	return false;
+}
+
+//! Igloo: once a commit that changed table's columns or properties has landed, the schema's table set
+//! holds the table as a bind last loaded it, from before the commit. Binds load a table again every
+//! time, and so saw the change at once, but listings show the set's entry as it is: the columns of an
+//! ALTER TABLE showed only once a later statement happened to bind the table, and ten ADD COLUMNs in a
+//! row listed the first nine. The entry is replaced by one not loaded yet, which listings show as they
+//! show a table no statement has used, until a bind loads it, as Igloo does before every statement that
+//! lists columns. Transactions holding the old entry keep it alive.
+static void ForgetListedTable(const IcebergTableInformation &table) {
+	if (!ChangesListedTable(table)) {
+		return;
+	}
+	auto &tables = table.schema.tables;
+	lock_guard<mutex> guard(tables.GetEntryLock());
+	auto &entries = tables.GetEntriesMutable();
+	auto it = entries.find(table.name);
+	if (it != entries.end()) {
+		it->second = make_shared_ptr<IcebergTableInformation>(table.catalog, table.schema, table.name);
+	}
+}
