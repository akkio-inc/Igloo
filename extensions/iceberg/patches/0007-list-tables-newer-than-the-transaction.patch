+optional_ptr<CatalogEntry> IcebergTableInformation::GetListedSchema(ClientContext &context) {
+	//! Igloo: a listing shows the catalog's tables as they are now, each at its schema as of the
+	//! transaction's start, as a bind sees it. A table created since has no schema that old, and a bind
+	//! of it fails the transaction (see CreateMetadataFromLog); a listing shows its current schema
+	//! instead. Igloo lists the catalog's tables to check a statement's grants, on the session's own
+	//! connection, so failing the listing failed every statement of a transaction older than any table
+	//! another session had created and read since.
+	try {
+		return GetLatestSchema(context);
+	} catch (TransactionException &) {
+		return schema_versions[table_metadata.GetCurrentSchemaId()].get();
+	}
+}
