# The rb extension's functions, in sqllogictest form (statement ok, statement
# error with the expected message after ----, query with its rows after ----,
# tab-separated). internal/engine's TestRBFunctions runs every *.test file
# here against Igloo's own DuckDB with the extension loaded.

statement ok
SET threads = 4

# rb_agg: the set of non-NULL ids, as a bitmap in CRoaring's portable format
query T
SELECT hex(rb_agg(x)) FROM (VALUES (1::UINTEGER), (5), (10000), (NULL), (5)) t(x)
----
3A300000010000000000020010000000010005001027

query I
SELECT rb_cardinality(rb_agg(x)) FROM (VALUES (1::UINTEGER), (5), (10000), (NULL), (5)) t(x)
----
3

# empty input, or only NULLs, gives an empty bitmap, never NULL
query IT
SELECT rb_cardinality(rb_agg(x)), hex(rb_agg(x)) FROM (SELECT 1::UINTEGER AS x WHERE false)
----
0	3A30000000000000

query I
SELECT rb_cardinality(rb_agg(NULL::UINTEGER)) FROM range(3)
----
0

# ids are UINTEGER: no BIGINT overload narrows silently, and a cast out of range fails
statement error
SELECT rb_agg(x::BIGINT) FROM range(3) t(x)
----
No function matches

statement error
SELECT rb_agg(CAST(-1 AS UINTEGER))
----
out of range

query I
SELECT rb_count_distinct(4294967295::UINTEGER)
----
1

# rb_count_distinct agrees with COUNT(DISTINCT), grouped and not, on enough rows for
# several threads, partial states and flushed buffers
statement ok
CREATE TABLE t AS SELECT (hash(i) % 997)::INTEGER AS g, CASE WHEN i % 89 = 0 THEN NULL ELSE (hash(i * 7) % 3000000)::UINTEGER END AS id, DATE '2025-01-01' + (hash(i * 13) % 91)::INTEGER AS d, (hash(i * 17) % 7)::SMALLINT AS k FROM range(3000000) r(i)

query I
SELECT count(*) FROM (SELECT g, count(DISTINCT id) AS a, rb_count_distinct(id) AS b FROM t GROUP BY g) WHERE a <> b
----
0

query I
SELECT count(DISTINCT id) = rb_count_distinct(id) FROM t
----
true

query I
SELECT count(*) FROM (SELECT g, rb_count_distinct(id) AS a, rb_cardinality(rb_agg(id)) AS b FROM t GROUP BY g) WHERE a <> b
----
0

query I
SELECT rb_count_distinct(id) FROM t WHERE g < 0
----
0

# groups whose ids are sparse in the domain stay sorted arrays, and dense ones
# become bitmaps: both agree with COUNT(DISTINCT), as counts and as bitmaps,
# under keys DuckDB groups by hashing (here 300 groups of 10,000 ids spread over
# all of UINTEGER, beside the dense groups of t above)
statement ok
CREATE TABLE sparse AS SELECT ((hash(i) % 300) * 1000003)::BIGINT AS g, (hash(i * 7) % 4294967295)::UINTEGER AS id FROM range(3000000) r(i)

query I
SELECT count(*) FROM (SELECT g, count(DISTINCT id) AS a, rb_count_distinct(id) AS b, rb_cardinality(rb_agg(id)) AS c FROM sparse GROUP BY g) WHERE a <> b OR a <> c
----
0

query I
SELECT count(*) FROM (SELECT g, list_sort(list_distinct(list(id))) AS a, rb_to_list(rb_agg(id)) AS b FROM sparse WHERE g < 20000000 GROUP BY g) WHERE a <> b
----
0

query I
SELECT count(*) FROM (SELECT g, list_sort(list_distinct(list(id))) AS a, rb_to_list(rb_agg(id)) AS b FROM t WHERE g < 20 GROUP BY g) WHERE a <> b
----
0

# a group's set may be an array in one partial state and a bitmap in another
query I
SELECT count(*) FROM (SELECT g, count(DISTINCT id) AS a, rb_count_distinct(id) AS b FROM (SELECT g, id FROM t UNION ALL SELECT g % 997, id FROM sparse) GROUP BY g) WHERE a <> b
----
0

# many small groups, most counted from their buffers alone, past the point
# where DuckDB's hash aggregate starts new partial states
query I
SELECT count(*) FROM (SELECT (hash(i) % 400000) * 1000003 AS g, count(DISTINCT (hash(i * 7) % 3000000)::UINTEGER) AS a, rb_count_distinct((hash(i * 7) % 3000000)::UINTEGER) AS b FROM range(3000000) r(i) GROUP BY g) WHERE a <> b
----
0

# a window combines states without consuming them, and finalizes the same
# states more than once
query I
SELECT count(*) FROM (SELECT count(DISTINCT id) OVER w AS a, rb_count_distinct(id) OVER w AS b FROM (SELECT i, (hash(i) % 5000)::UINTEGER AS id FROM range(200000) r(i)) WINDOW w AS (ORDER BY i ROWS BETWEEN 3000 PRECEDING AND CURRENT ROW)) WHERE a <> b
----
0

# pair counts: COUNT(DISTINCT id, k) skipping rows with a NULL, in either argument order
query I
SELECT count(*) FROM (SELECT g, count(DISTINCT CASE WHEN id IS NOT NULL AND d IS NOT NULL THEN (id, d) END) AS a, rb_count_distinct(id, d) AS b, rb_count_distinct(d, id) AS c FROM t GROUP BY g) WHERE a <> b OR a <> c
----
0

query I
SELECT count(*) FROM (SELECT g, count(DISTINCT CASE WHEN id IS NOT NULL THEN (id, k) END) AS a, rb_count_distinct(id, k) AS b, rb_count_distinct(k, id) AS c FROM t GROUP BY g) WHERE a <> b OR a <> c
----
0

query I
SELECT rb_count_distinct(x::UINTEGER, y::UINTEGER) FROM (VALUES (1, 1), (1, 1), (1, 2), (2, 1), (NULL, 1), (3, NULL)) v(x, y)
----
3

# rb_or_agg: the union of non-NULL bitmaps
query I
SELECT rb_cardinality(rb_or_agg(b)) = (SELECT count(DISTINCT id) FROM t WHERE g < 500) FROM (SELECT g, rb_agg(id) AS b FROM t WHERE g < 500 GROUP BY g)
----
true

query I
SELECT rb_cardinality(rb_or_agg(b)) FROM (VALUES (NULL::BLOB)) v(b)
----
0

# set operations and their cardinalities
statement ok
CREATE TABLE s AS SELECT (SELECT rb_agg(x::UINTEGER) FROM range(0, 100) r(x)) AS a, (SELECT rb_agg(x::UINTEGER) FROM range(50, 200) r(x)) AS b

query IIIIII
SELECT rb_cardinality(rb_and(a, b)), rb_cardinality(rb_or(a, b)), rb_cardinality(rb_andnot(a, b)), rb_and_cardinality(a, b), rb_or_cardinality(a, b), rb_andnot_cardinality(a, b) FROM s
----
50	200	50	50	200	50

query TT
SELECT rb_contains(a, 99::UINTEGER), rb_contains(a, 100::UINTEGER) FROM s
----
true	false

query T
SELECT rb_to_list(rb_and(a, rb_agg_small))::VARCHAR FROM s, (SELECT rb_agg(x::UINTEGER) AS rb_agg_small FROM (VALUES (3), (98), (150)) v(x))
----
[3, 98]

query T
SELECT rb_to_list(rb_agg(x))::VARCHAR FROM (SELECT 1::UINTEGER AS x WHERE false)
----
[]

# a bitmap that is the same for every row (a subquery's) is read once a chunk; one that differs row to row,
# empty ones (short enough to be inlined) among them, is read every row
statement ok
CREATE TABLE many AS SELECT g, CASE WHEN g % 7 = 3 THEN (SELECT rb_agg(x) FROM (SELECT 1::UINTEGER AS x WHERE false)) ELSE rb_agg(i::UINTEGER) END AS bm FROM (SELECT i % 5000 AS g, i FROM range(400000) r(i)) GROUP BY g

query III
SELECT count(*), sum(rb_and_cardinality(bm, (SELECT rb_agg(i::UINTEGER) FROM range(0, 400000, 2) r(i)))), sum(rb_andnot_cardinality((SELECT rb_agg(i::UINTEGER) FROM range(0, 400000, 2) r(i)), bm)) FROM many
----
5000	171440	999828560

query I
SELECT count(*) FILTER (WHERE rb_contains((SELECT rb_agg(i::UINTEGER) FROM range(0, 300000, 3) r(i)), j::UINTEGER)) FROM range(300000) t(j)
----
100000

# a bitmap known when the statement is bound, a variable's or a literal's, is read once for the whole statement
# (not copied and read for each chunk); one that is NULL gives NULL, and one that is not a bitmap fails at bind
statement ok
SET VARIABLE evens = (SELECT rb_agg(i::UINTEGER) FROM range(0, 20000000, 2) r(i))

query III
SELECT count(*) FILTER (WHERE rb_contains(getvariable('evens'), (j % 20000000)::UINTEGER)),
       count(*) FILTER (WHERE rb_contains(CAST(getvariable('evens') AS BLOB), j::UINTEGER)),
       count(*) FILTER (WHERE rb_contains(getvariable('evens'), (j + 1)::UINTEGER) AND rb_contains(getvariable('evens'), j::UINTEGER))
FROM range(30000000) t(j)
----
15000000	10000000	0

query TT
SELECT rb_contains(getvariable('no_such_variable'), 1::UINTEGER), rb_contains(CAST(NULL AS BLOB), j::UINTEGER) FROM range(1) t(j)
----
NULL	NULL

statement error
SELECT rb_contains(CAST('not a bitmap at all' AS BLOB), j::UINTEGER) FROM range(3) t(j)
----
rb: invalid bitmap BLOB

statement ok
RESET VARIABLE evens

# NULL in, NULL out
query TTTT
SELECT rb_cardinality(NULL), rb_and(a, NULL) IS NULL, rb_contains(NULL, 1::UINTEGER), rb_to_list(NULL) FROM s
----
NULL	true	NULL	NULL

# a BLOB that is not a bitmap, or one cut short or padded, is refused by name
statement error
SELECT rb_cardinality('\x01\x02\x03'::BLOB)
----
rb: invalid bitmap BLOB

statement error
SELECT rb_cardinality(unhex(left(hex(a), 20))) FROM s
----
rb: invalid bitmap BLOB

statement error
SELECT rb_cardinality(a || '\x00'::BLOB) FROM s
----
rb: invalid bitmap BLOB

# rb_count_distinct = 'always' counts COUNT(DISTINCT) of unsigned ids up to
# 32 bits in bitmaps, with the same results; 'off' (the default) leaves it to
# DuckDB's hash
query T
SELECT current_setting('rb_count_distinct')
----
off

statement error
SET rb_count_distinct = 'auto'
----
rb_count_distinct is 'off' or 'always'

statement ok
SET rb_count_distinct = 'ALWAYS'

query T
SELECT current_setting('rb_count_distinct')
----
always

query I
SELECT count(*) FROM (SELECT g, count(DISTINCT id) AS a, count(DISTINCT id::BIGINT) AS b, count(DISTINCT id) FILTER (WHERE true) AS c FROM t GROUP BY g) WHERE a <> b OR a <> c
----
0

query I
SELECT count(*) FROM (SELECT g, count(DISTINCT (id % 60000)::USMALLINT) AS a, count(DISTINCT id % 60000) AS b FROM t GROUP BY g) WHERE a <> b
----
0

query I
SELECT count(DISTINCT id) = (SELECT count(DISTINCT id::BIGINT) FROM t) FROM t
----
true

# which aggregates it rewrites shows in what a small bitmap budget refuses:
# COUNT(DISTINCT) of a UINTEGER, grouped or not, and nothing else
statement ok
SET rb_memory_budget = '4MB'

statement error
SELECT g, count(DISTINCT (hash(i) % 4294967295)::UINTEGER) FROM range(2000000) r(i), (SELECT i % 4 AS g) GROUP BY g
----
rb: bitmap memory budget exceeded

statement error
SELECT count(DISTINCT (hash(i) % 4294967295)::UINTEGER) FROM range(2000000) r(i)
----
rb: bitmap memory budget exceeded

query I
SELECT count(*) FROM (SELECT g, count(DISTINCT (hash(i) % 4294967295)::BIGINT) AS a, count(DISTINCT (hash(i) % 4294967295)::UINTEGER) FILTER (WHERE i >= 0) AS b, count(DISTINCT CASE WHEN i >= 0 THEN ((hash(i) % 4294967295)::UINTEGER, g) END) AS c FROM range(2000000) r(i), (SELECT i % 4 AS g) GROUP BY g) WHERE a = b AND a = c
----
4

query I
SELECT count(*) FROM (SELECT count(DISTINCT (hash(i) % 4294967295)::UINTEGER) OVER (ORDER BY i ROWS BETWEEN 1000 PRECEDING AND CURRENT ROW) AS a FROM range(20000) r(i)) WHERE a > 0
----
20000

statement ok
SET rb_count_distinct = 'off'

query I
SELECT count(*) FROM (SELECT g, count(DISTINCT (hash(i) % 4294967295)::UINTEGER) AS a FROM range(2000000) r(i), (SELECT i % 4 AS g) GROUP BY g) WHERE a > 400000
----
4

statement ok
RESET rb_memory_budget

statement ok
RESET rb_count_distinct

# memory: a statement whose bitmaps outgrow rb_memory_budget fails with the
# error Igloo reruns on the hash path, and bitmaps count toward DuckDB's
# memory limit
statement ok
SET rb_memory_budget = '4MB'

statement error
SELECT g, rb_count_distinct((hash(i) % 4294967295)::UINTEGER) FROM range(2000000) r(i), (SELECT i % 4 AS g) GROUP BY g
----
rb: bitmap memory budget exceeded

statement ok
RESET rb_memory_budget

query I
SELECT rb_count_distinct((hash(i) % 4294967295)::UINTEGER) > 1999000 FROM range(2000000) r(i)
----
true

# 24 million ids spread over all of UINTEGER take some 96 MB: past a 64 MB
# memory limit, the bitmaps' reservation or DuckDB's next allocation fails,
# whichever comes first (the tables above leave DuckDB little room)
statement ok
DROP TABLE t; DROP TABLE sparse; DROP TABLE s

statement ok
SET memory_limit = '64MB'

statement error
SELECT g, rb_count_distinct((hash(i) % 4294967295)::UINTEGER) FROM range(24000000) r(i), (SELECT i % 8 AS g) GROUP BY g
----
Out of Memory Error

statement ok
RESET memory_limit
