{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values for the Igloo Helm chart",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "secretName": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
      "maxLength": 253
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "quantity": {
      "type": [
        "string",
        "integer",
        "number"
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        },
        "limits": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        }
      }
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "postgresUrl": {
      "type": "string",
      "pattern": "^$|^postgres(ql)?://"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "probe": {
      "type": [
        "object",
        "null"
      ]
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "description": "Lowercase letters, digits and underscores, not starting with a digit."
        },
        "existingSecret": {
          "$ref": "#/definitions/secretName"
        },
        "password": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "minLength": 16
            }
          ],
          "description": "At least 16 characters, and not a placeholder such as change-me or easily guessed; empty generates one.",
          "$comment": "Lengths rather than a pattern: Helm prints the value that fails a pattern."
        }
      }
    },
    "erasure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "$ref": "#/definitions/secretName"
        }
      }
    },
    "metadataDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "$ref": "#/definitions/secretName"
        },
        "url": {
          "$ref": "#/definitions/postgresUrl"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warehouseLocation": {
          "type": "string",
          "pattern": "^$|^(s3|gs|abfss)://[^/]+"
        },
        "allowedLocations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+://"
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "urlStyle": {
              "type": "string",
              "enum": [
                "vhost",
                "path"
              ]
            },
            "useSSL": {
              "type": "boolean"
            },
            "existingSecret": {
              "$ref": "#/definitions/secretName"
            },
            "stsRoleArn": {
              "type": "string",
              "pattern": "^$|^arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
            }
          }
        },
        "gcs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "$ref": "#/definitions/secretName"
            }
          }
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "$ref": "#/definitions/secretName"
            }
          }
        }
      }
    },
    "duckdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memoryLimit": {
          "type": [
            "string",
            "null"
          ]
        },
        "threads": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "spillVolume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": {
              "type": [
                "string",
                "null"
              ]
            },
            "medium": {
              "type": "string",
              "enum": [
                "",
                "Memory"
              ]
            }
          }
        },
        "maxTempSize": {
          "type": "string",
          "description": "DuckDB size such as 40GiB; empty for 90% of spillVolume.sizeLimit."
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "$ref": "#/definitions/secretName"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ]
        },
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "statementTimeout": {
      "description": "A Go duration such as 30m or 1h30m; empty for no limit.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^$|^0$|^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        {
          "type": "integer",
          "const": 0
        }
      ]
    },
    "maxConnections": {
      "type": "integer",
      "minimum": 1
    },
    "extraEnv": {
      "$ref": "#/definitions/envList"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle": {
      "type": "object"
    },
    "strategy": {
      "type": "object"
    },
    "startupProbe": {
      "$ref": "#/definitions/probe"
    },
    "livenessProbe": {
      "$ref": "#/definitions/probe"
    },
    "readinessProbe": {
      "$ref": "#/definitions/probe"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "loadBalancerClass": {
          "type": "string"
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "flightSQL": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "iceberg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "sso": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^$|^https://|^http://(localhost|127\\.0\\.0\\.1)(:|/|$)",
          "description": "The identity provider's issuer URL, https."
        },
        "clientId": {
          "type": "string"
        },
        "existingSecret": {
          "$ref": "#/definitions/secretName"
        },
        "redirectUrl": {
          "type": "string",
          "pattern": "^$|^https://[^/]+/sso/callback$",
          "description": "https://<console host>/sso/callback, or empty."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s,]+$"
          }
        },
        "usernameClaim": {
          "type": "string",
          "minLength": 1
        },
        "groupsClaim": {
          "type": "string",
          "minLength": 1
        },
        "allowedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s,]+$"
          }
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^,]+$"
          }
        },
        "createUsers": {
          "type": "boolean"
        },
        "passwordSignIn": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string"
        },
        "accessTokenAudience": {
          "type": "string"
        }
      }
    },
    "tokenMaxLifetime": {
      "type": "string",
      "pattern": "^[0-9]+d$|^([0-9.]+(h|m|s))+$",
      "description": "A Go duration or a number of days, at least 1h, e.g. 365d."
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "scaleToZero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "suspendAfter": {
          "description": "A Go duration such as 10m.",
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "resumeTimeout": {
          "description": "A Go duration such as 5m.",
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "replicas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "pricePerHour": {
      "type": "number",
      "minimum": 0,
      "description": "Hourly price of one igloo pod's machine, for igloo.usage; 0 for unknown."
    },
    "pools": {
      "type": "array",
      "description": "Compute pools: more igloo Deployments sharing the catalog and metadata database.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]([-a-z0-9]{0,18}[a-z0-9])?$",
            "description": "1 to 20 lowercase letters, digits and hyphens, starting with a letter."
          },
          "replicaCount": {
            "type": "integer",
            "minimum": 0
          },
          "pricePerHour": {
            "$ref": "#/properties/pricePerHour"
          },
          "resources": {
            "$ref": "#/definitions/resources"
          },
          "duckdb": {
            "$ref": "#/properties/duckdb"
          },
          "statementTimeout": {
            "$ref": "#/properties/statementTimeout"
          },
          "maxConnections": {
            "$ref": "#/properties/maxConnections"
          },
          "extraEnv": {
            "$ref": "#/definitions/envList"
          },
          "podLabels": {
            "$ref": "#/definitions/stringMap"
          },
          "podAnnotations": {
            "$ref": "#/definitions/stringMap"
          },
          "nodeSelector": {
            "$ref": "#/definitions/stringMap"
          },
          "tolerations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "affinity": {
            "type": "object"
          },
          "topologySpreadConstraints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "priorityClassName": {
            "type": "string"
          },
          "service": {
            "$ref": "#/properties/service"
          },
          "scaleToZero": {
            "$ref": "#/properties/scaleToZero"
          },
          "workers": {
            "$ref": "#/properties/workers"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sqlFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "objectStorageFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "warehouse": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "$ref": "#/definitions/secretName"
            },
            "url": {
              "$ref": "#/definitions/postgresUrl"
            }
          }
        },
        "encryptionKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "$ref": "#/definitions/secretName"
            }
          }
        },
        "systemCredentials": {
          "type": "string",
          "enum": [
            "none",
            "aws",
            "gcp",
            "azure"
          ]
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "objectStorage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
          "description": "An S3 bucket name."
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "initImage": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "snapshotRetention": {
          "description": "A Go duration such as 36h, or whole days such as 7d.",
          "type": "string",
          "pattern": "^[0-9]+d$|^0$|^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        }
      }
    },
    "shutdownDelay": {
      "description": "A Go duration such as 5s; empty or 0 for none.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^$|^0$|^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        {
          "type": "integer",
          "const": 0
        }
      ]
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "idleAfter": {
          "description": "A Go duration such as 10m, or auto.",
          "type": "string",
          "pattern": "^auto$|^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "startTimeout": {
          "description": "A Go duration such as 10m.",
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "exchanges": {
          "description": "Where workers exchange rows: object storage, or their own disks.",
          "enum": [
            "object",
            "local"
          ]
        },
        "existingSecret": {
          "type": "string"
        },
        "duckdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memoryLimit": {
              "type": "string"
            },
            "threads": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "spillVolume": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sizeLimit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "medium": {
                  "type": "string",
                  "enum": [
                    "",
                    "Memory"
                  ]
                }
              }
            }
          }
        },
        "cacheVolume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "podLabels": {
