# Igloo single-machine settings. Create .env from this file with ./init-env.sh,
# which replaces every "change-me" with a random value.

# --- Image --------------------------------------------------------------------
# Empty builds Igloo from this checkout. Set a released image to skip the
# build, e.g. ghcr.io/akkio-inc/igloo:1.0.0, and start with
# `docker compose up -d --no-build`.
IGLOO_IMAGE=

# --- SQL endpoint -----------------------------------------------------------
# The first administrator. The password is used to create the account on
# first start only; change it later with ALTER USER (or psql's \password).
IGLOO_ADMIN_USER=igloo
IGLOO_ADMIN_PASSWORD=change-me
# Host port for Postgres clients. 5433 avoids clashing with a local Postgres.
IGLOO_PORT=5433
# 127.0.0.1 accepts local clients only. Use 0.0.0.0 to accept remote clients,
# after turning on TLS below.
IGLOO_BIND=127.0.0.1
# Host port for health checks and Prometheus metrics, and the address it
# binds to. A scale-to-zero gateway on another machine needs the private
# address here (docs/scale-to-zero.md); never expose it to the internet.
IGLOO_HTTP_PORT=8432
IGLOO_HTTP_BIND=127.0.0.1
# Host port for the web console, and the address it binds to. Without TLS it
# accepts sign-ins only from a browser on this machine (or through an SSH
# tunnel); turn on TLS below before binding it to 0.0.0.0.
IGLOO_CONSOLE_PORT=8443
IGLOO_CONSOLE_BIND=127.0.0.1
# Cap DuckDB's memory, e.g. 8GB. Empty uses 80% of the machine.
IGLOO_MEMORY_LIMIT=
# Cap the local disk cache of table files, e.g. 50GB; 0 turns it off. Empty
# lets it use half of the free disk space, up to 100 GiB.
IGLOO_CACHE_SIZE=
# Extra locations users may load data from or export to, comma separated,
# e.g. s3://landing-bucket/. Everything else outside the warehouse is blocked.
IGLOO_ALLOWED_LOCATIONS=
# TLS, for SQL clients and the web console: put a certificate and key in
# ./tls and set:
#   IGLOO_TLS_CERT_FILE=/tls/tls.crt
#   IGLOO_TLS_KEY_FILE=/tls/tls.key
IGLOO_TLS_CERT_FILE=
IGLOO_TLS_KEY_FILE=

# --- Catalog ----------------------------------------------------------------
WAREHOUSE=igloo
CATALOG_DB_PASSWORD=change-me
CATALOG_ENCRYPTION_KEY=change-me

# --- Table storage ----------------------------------------------------------
# Default: the bundled local object store, data kept in a Docker volume.
COMPOSE_PROFILES=local-storage
S3_BUCKET=igloo
S3_ENDPOINT=storage:9000
S3_REGION=us-east-1
S3_URL_STYLE=path
S3_USE_SSL=false
S3_ACCESS_KEY_ID=igloo
S3_SECRET_ACCESS_KEY=change-me

# To keep tables in Amazon S3 instead: create the bucket, then set
#   COMPOSE_PROFILES=
#   S3_BUCKET=<your bucket>
#   S3_ENDPOINT=
#   S3_REGION=<bucket region>
#   S3_URL_STYLE=vhost
#   S3_USE_SSL=true
# and either set S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY or leave both empty
# to use the machine's IAM role.
