# Igloo single-machine settings. Create .env from this file with ./init-env.sh,
# which replaces every "change-me" with a random value.

# --- Image --------------------------------------------------------------------
# Empty builds Igloo from this checkout. Set a released image to skip the
# build, e.g. ghcr.io/akkio-inc/igloo:1.0.0, and start with
# `docker compose up -d --no-build`.
IGLOO_IMAGE=

# --- SQL endpoint -----------------------------------------------------------
# The first administrator. The password is used to create the account on
# first start only; change it later with ALTER USER (or psql's \password).
# Igloo creates the account only with 16 or more characters that are not a
# placeholder: init-env.sh replaces change-me with 32 random ones, and Igloo
# refuses change-me itself. Copying this file by hand? Set a long random
# value, e.g. from `openssl rand -base64 24`.
IGLOO_ADMIN_USER=igloo
IGLOO_ADMIN_PASSWORD=change-me
# Seals the identifiers of erasure requests (ERASE SUBJECT) while they run.
# Keep it: requests that are running when it changes must be made again.
IGLOO_ERASURE_KEY=change-me
# Host port for Postgres clients. 5433 avoids clashing with a local Postgres.
IGLOO_PORT=5433
# 127.0.0.1 accepts local clients only. Use 0.0.0.0 to accept remote clients,
# after turning on TLS below.
IGLOO_BIND=127.0.0.1
# Host port for health checks and Prometheus metrics, and the address it
# binds to. A scale-to-zero gateway on another machine needs the private
# address here (docs/scale-to-zero.md); never expose it to the internet.
IGLOO_HTTP_PORT=8432
IGLOO_HTTP_BIND=127.0.0.1
# Host port for the web console, and the address it binds to. Without TLS it
# accepts sign-ins only from a browser on this machine (or through an SSH
# tunnel); turn on TLS below before binding it to 0.0.0.0.
IGLOO_CONSOLE_PORT=8443
IGLOO_CONSOLE_BIND=127.0.0.1
# Host port for Arrow Flight SQL (ADBC, pyarrow, the Flight SQL JDBC
# driver), and the address it binds to. Without TLS it serves only clients
# on this machine (or through an SSH tunnel); turn on TLS below before
# binding it to 0.0.0.0.
IGLOO_FLIGHT_PORT=31337
IGLOO_FLIGHT_BIND=127.0.0.1
# Host port for the Iceberg REST catalog that Spark, Trino, PyIceberg and
# other engines use (docs/external-engines.md), and the address it binds to.
# Without TLS it serves clients on private networks only; turn on TLS below
# before binding it to 0.0.0.0.
IGLOO_ICEBERG_PORT=8181
IGLOO_ICEBERG_BIND=127.0.0.1
# Host port for the Delta Sharing endpoint, which recipients of shares read
# from, and the address it binds to. Recipients outside this machine need
# TLS below, IGLOO_SHARING_BIND=0.0.0.0, and the public address in
# IGLOO_SHARING_URL, e.g. https://data.example.com:8444 (docs/sharing.md).
IGLOO_SHARING_PORT=8444
IGLOO_SHARING_BIND=127.0.0.1
IGLOO_SHARING_URL=
# Cap DuckDB's memory, e.g. 8GB. Empty uses 80% of the machine; the rest of
# Igloo gets what that leaves, less a twentieth, so with the bundled services
# on the same machine, leave room for them too.
IGLOO_MEMORY_LIMIT=
# Cap the memory compaction holds while it rewrites a table's files, e.g. 2GB.
# Empty uses a quarter of what IGLOO_MEMORY_LIMIT leaves the rest of Igloo.
IGLOO_MAINTENANCE_MEMORY=
# Cap the local disk cache of table files, e.g. 50GB; 0 turns it off. Empty
# lets it use half of the free disk space, up to 100 GiB.
IGLOO_CACHE_SIZE=
# Cap the memory the results Igloo keeps of queries take, to send them again
# while no table changes, e.g. 1GB; 0 turns the result cache off. Empty
# keeps up to 256 MiB.
IGLOO_RESULT_CACHE_SIZE=
# How many queries and changes of data may run at once, for every user
# together, e.g. 8, or auto for as many as the cores; further ones wait in
# line. Empty or off means no limit.
IGLOO_MAX_CONCURRENT_STATEMENTS=
# The fraction of what a statement like it allocated last that a statement
# reserves of DuckDB's memory before it starts, so that heavy ones do not
# start together and spill, e.g. 0.5; off reserves nothing. Empty is auto,
# all of it (1).
IGLOO_STATEMENT_RESERVATIONS=
# Host directory for DuckDB's spill files, which large joins, aggregations
# and sorts write and read back, e.g. /mnt/nvme/igloo-spill on an instance
# store or local SSD. Empty keeps them in the igloo-spill volume, in Docker's
# data directory. Create it for the user Igloo runs as:
#   sudo install -d -o 65532 -g 65532 /mnt/nvme/igloo-spill
# Spill files only live for a query, so a disk emptied when the machine
# stops is fine; format, mount and create it again at boot, before Docker
# starts the stack (docs/operations.md#spill-on-local-nvme).
IGLOO_SPILL_DIR=
# What this machine costs an hour, e.g. 0.58, for the cost estimates of
# igloo.usage. 0 means unknown.
IGLOO_PRICE_PER_HOUR=0
# Extra locations users may load data from or export to, comma separated,
# e.g. s3://landing-bucket/. Everything else outside the warehouse is blocked.
IGLOO_ALLOWED_LOCATIONS=

# --- Distributed execution --------------------------------------------------
# Worker containers that run parts of large statements
# (docs/distributed-execution.md). To try them, add workers to
# COMPOSE_PROFILES below and set IGLOO_WORKERS=worker.
IGLOO_WORKERS=
IGLOO_WORKER_REPLICAS=2
# Shared by igloo and its workers; they accept only each other.
IGLOO_WORKER_SECRET=change-me
# Cap each worker's DuckDB memory and threads, e.g. 4GB and 4.
IGLOO_WORKER_MEMORY_LIMIT=
IGLOO_WORKER_THREADS=
# Where workers exchange rows between a statement's stages: object (the
# bucket), local (their own disks) or auto (their disks when every worker
# has room there). On machines with local NVMe, auto is recommended.
IGLOO_EXCHANGES=object

# TLS, for SQL and Flight SQL clients and the web console: put a certificate
# and key in ./tls and set:
#   IGLOO_TLS_CERT_FILE=/tls/tls.crt
#   IGLOO_TLS_KEY_FILE=/tls/tls.key
IGLOO_TLS_CERT_FILE=
IGLOO_TLS_KEY_FILE=

# --- Single sign-on (docs/sso.md) -------------------------------------------
# Let people sign in to the console with Okta, Microsoft Entra ID, Google
# Workspace or another OpenID Connect provider, and give SQL clients access
# tokens. Turn on TLS above first, unless the console is used only at
# localhost. Register https://<host>:<IGLOO_CONSOLE_PORT>/sso/callback at the
# provider as the redirect URI.
IGLOO_OIDC_ISSUER=
IGLOO_OIDC_CLIENT_ID=
IGLOO_OIDC_CLIENT_SECRET=
# Only these email domains, and members of these groups, may sign in; comma
# separated. Set at least one of them for Google Workspace.
IGLOO_OIDC_ALLOWED_DOMAINS=
IGLOO_OIDC_ALLOWED_GROUPS=
# More settings, with their defaults (docs/configuration.md):
#   IGLOO_OIDC_REDIRECT_URL=            derived from the request
#   IGLOO_OIDC_SCOPES=openid profile email
#   IGLOO_OIDC_USERNAME_CLAIM=email     preferred_username for Entra ID
#   IGLOO_OIDC_GROUPS_CLAIM=groups
#   IGLOO_OIDC_CREATE_USERS=true        create users, role none, at first sign-in
#   IGLOO_OIDC_PASSWORD_SIGNIN=true     false: SSO users may not use passwords
#   IGLOO_OIDC_DISPLAY_NAME=SSO
#   IGLOO_OIDC_ACCESS_TOKEN_AUDIENCE=   accept the provider's access tokens in SQL
#   IGLOO_OIDC_ACCESS_TOKEN_ID_CLAIM=   their account ID claim: uid (Okta), oid (Entra ID)
#   IGLOO_TOKEN_MAX_LIFETIME=365d       longest lifetime of an access token

# --- Alerts and notifications (docs/alerts.md) -------------------------------
# Slack, Teams and webhooks need nothing here: notifications reach public
# HTTPS endpoints. Hosts on a private network they may reach anyway, such as
# an internal webhook receiver or mail relay, comma separated:
IGLOO_NOTIFICATION_ALLOW_HOSTS=
# Email alerts: the mail server (STARTTLS on 587, TLS on 465), the sender,
# and the only domains alerts may send to.
IGLOO_SMTP_HOST=
IGLOO_SMTP_PORT=
IGLOO_SMTP_FROM=
IGLOO_SMTP_ALLOWED_DOMAINS=
IGLOO_SMTP_USERNAME=
IGLOO_SMTP_PASSWORD=
# --- Lineage events (docs/catalog.md#openlineage) ----------------------------
# Send the lineage of statements that write tables to Marquez, DataHub or
# another OpenLineage endpoint (https). Events carry no query results.
#   IGLOO_OPENLINEAGE_URL=https://marquez.example.com/api/v1/lineage
#   IGLOO_OPENLINEAGE_API_KEY=
#   IGLOO_OPENLINEAGE_SEND_SQL=false        true: include statements' text
#   IGLOO_OPENLINEAGE_ALLOW_PRIVATE=false   true: allow private addresses and http

# --- Catalog ----------------------------------------------------------------
WAREHOUSE=igloo
CATALOG_DB_PASSWORD=change-me
CATALOG_ENCRYPTION_KEY=change-me

# --- Table storage ----------------------------------------------------------
# Default: the bundled local object store, data kept in a Docker volume.
COMPOSE_PROFILES=local-storage
S3_BUCKET=igloo
S3_ENDPOINT=storage:9000
S3_REGION=us-east-1
S3_URL_STYLE=path
S3_USE_SSL=false
S3_ACCESS_KEY_ID=igloo
S3_SECRET_ACCESS_KEY=change-me

# To keep tables in Amazon S3 instead: create the bucket, then set
#   COMPOSE_PROFILES=
#   S3_BUCKET=<your bucket>
#   S3_ENDPOINT=
#   S3_REGION=<bucket region>
#   S3_URL_STYLE=vhost
#   S3_USE_SSL=true
# and either set S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY or leave both empty
# to use the machine's IAM role. To hand other engines credentials limited to
# one table, also set S3_STS_ROLE_ARN to a role Igloo may assume
# (docs/external-engines.md#amazon-s3).
S3_STS_ROLE_ARN=
