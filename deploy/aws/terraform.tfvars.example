# Copy to terraform.tfvars and edit. Every setting is optional; see
# variables.tf for the full list and defaults.

region      = "us-east-1"
name_prefix = "igloo"

# Limit the Kubernetes API endpoint to your own network. Find your address
# with: curl -s https://checkip.amazonaws.com
# cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

# Give teammates or CI kubectl access (the identity running tofu gets it
# automatically; do not list it here).
# cluster_admin_arns = ["arn:aws:iam::111122223333:role/DataPlatformAdmins"]

# Pin the Igloo version. Empty uses the chart's appVersion.
# igloo_image_tag = "0.1.0"

# Reach SQL from outside the cluster through a Network Load Balancer.
# expose_sql        = true
# sql_allowed_cidrs = ["203.0.113.0/24"]

# Cheaper, interruptible nodes. List several Graviton types for Spot capacity;
# "d" types keep DuckDB's spill files on their local NVMe.
# node_use_spot       = true
# node_instance_types = ["r7gd.xlarge", "r6gd.xlarge", "r8gd.xlarge"]

# Distributed-execution workers on Spot nodes (on-demand when Spot has no
# capacity), from zero nodes; and one large worker on an on-demand
# r7gd.16xlarge. Prices let auto mode weigh cost.
# workers_enabled             = true
# workers_price_per_hour      = 0.30
# large_worker_enabled        = true
# large_worker_price_per_hour = 4.36

tags = {
  Team = "data"
}
