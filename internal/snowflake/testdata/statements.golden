-- SELECT IFF(a > 0, 'pos', 'neg') AS sign FROM t
SELECT CASE WHEN (a > 0) THEN 'pos' ELSE 'neg' END AS "SIGN" FROM t

-- SELECT NVL(a, 0), NVL2(a, 1, 2), ZEROIFNULL(a), NULLIFZERO(a), EQUAL_NULL(a, b) FROM t
SELECT coalesce(a, 0) AS "NVL(A, 0)", CASE WHEN a IS NOT NULL THEN 1 ELSE 2 END AS "NVL2(A, 1, 2)", coalesce(a, 0) AS "ZEROIFNULL(A)", nullif(a, 0) AS "NULLIFZERO(A)", (a IS NOT DISTINCT FROM b) AS "EQUAL_NULL(A, B)" FROM t

-- SELECT DECODE(x, 1, 'one', 2, 'two', 'other') FROM t
SELECT CASE WHEN x IS NOT DISTINCT FROM 1 THEN 'one' WHEN x IS NOT DISTINCT FROM 2 THEN 'two' ELSE 'other' END AS "DECODE(X, 1, 'ONE', 2, 'TWO', 'OTHER')" FROM t

-- SELECT DIV0(a, b), DIV0NULL(a, b) FROM t
SELECT CASE WHEN b = 0 THEN 0 ELSE sf_div(a, b) END AS "DIV0(A, B)", CASE WHEN b = 0 OR b IS NULL THEN 0 ELSE sf_div(a, b) END AS "DIV0NULL(A, B)" FROM t

-- SELECT GREATEST(a, b), LEAST(a, b) FROM t
SELECT CASE WHEN a IS NULL OR b IS NULL THEN NULL ELSE greatest(a, b) END AS "GREATEST(A, B)", CASE WHEN a IS NULL OR b IS NULL THEN NULL ELSE least(a, b) END AS "LEAST(A, B)" FROM t

-- SELECT DATEADD(day, 1, d), DATEADD('month', -1, d), TIMESTAMPADD(hour, 2, ts) FROM t
SELECT sf_add_days(d, 1, 1) AS "DATEADD(DAY, 1, D)", sf_add_months(d, -1, 1) AS "DATEADD('MONTH', -1, D)", sf_add_micros(ts, 2, 3600000000) AS "TIMESTAMPADD(HOUR, 2, TS)" FROM t

-- SELECT DATEDIFF(day, a, b), DATEDIFF('week', a, b) FROM t
SELECT date_diff('day', a, b) AS "DATEDIFF(DAY, A, B)", (date_diff('day', date_trunc('week', a), date_trunc('week', b)) // 7) AS "DATEDIFF('WEEK', A, B)" FROM t

-- SELECT DATE_TRUNC('MONTH', ts), TRUNC(d, 'YEAR'), TRUNC(n, 2) FROM t
SELECT sf_date_trunc('month', ts) AS "DATE_TRUNC('MONTH', TS)", sf_date_trunc('year', d) AS "TRUNC(D, 'YEAR')", CAST(trunc(n * 100) / 100 AS DECIMAL(38,2)) AS "TRUNC(N, 2)" FROM t

-- SELECT LAST_DAY(d), LAST_DAY(d, 'week'), DAYNAME(d), MONTHNAME(d), NEXT_DAY(d, 'friday') FROM t
SELECT last_day(d) AS "LAST_DAY(D)", (CAST(date_trunc('week', d) AS DATE) + 6) AS "LAST_DAY(D, 'WEEK')", strftime(d, '%a') AS "DAYNAME(D)", strftime(d, '%b') AS "MONTHNAME(D)", sf_next_day(d, 'friday') AS "NEXT_DAY(D, 'FRIDAY')" FROM t

-- SELECT DATE_PART(epoch_second, ts), EXTRACT(dayofweek FROM d), YEAROFWEEK(d) FROM t
SELECT CAST(floor(date_part('epoch', ts)) AS BIGINT) AS "DATE_PART(EPOCH_SECOND, TS)", date_part('dow', d) AS "EXTRACT(DAYOFWEEK FROM D)", isoyear(d) AS "YEAROFWEEK(D)" FROM t

-- SELECT TO_DATE(s), TO_DATE(s, 'MM/DD/YYYY'), TRY_TO_DATE(s) FROM t
SELECT sf_to_date(s) AS "TO_DATE(S)", CAST(strptime(s, '%m/%d/%Y') AS DATE) AS "TO_DATE(S, 'MM/DD/YYYY')", sf_try_to_date(s) AS "TRY_TO_DATE(S)" FROM t

-- SELECT TO_TIMESTAMP(s), TO_TIMESTAMP_LTZ(ms, 3), TO_TIMESTAMP_NTZ(s, 'YYYY-MM-DD HH24:MI:SS') FROM t
SELECT sf_to_timestamp(s) AS "TO_TIMESTAMP(S)", to_timestamp(ms / 1e3) AS "TO_TIMESTAMP_LTZ(MS, 3)", CAST(strptime(s, '%Y-%m-%d %H:%M:%S') AS TIMESTAMP) AS "TO_TIMESTAMP_NTZ(S, 'YYYY-MM-DD HH24:MI:SS')" FROM t

-- SELECT TO_CHAR(d, 'YYYY-MM-DD'), TO_VARCHAR(n), TO_NUMBER(s, 10, 2) FROM t
SELECT strftime(d, '%Y-%m-%d') AS "TO_CHAR(D, 'YYYY-MM-DD')", CASE WHEN typeof(n) = 'JSON' THEN json_extract_string(CAST(n AS JSON), '$') WHEN typeof(n) IN ('DOUBLE', 'FLOAT') THEN CASE WHEN isnan(CAST(n AS DOUBLE)) THEN 'NaN' ELSE format('{:.12g}', CAST(n AS DOUBLE)) END WHEN typeof(n) IN ('TIMESTAMP', 'TIMESTAMP_S', 'TIMESTAMP_MS', 'TIMESTAMP_NS') THEN strftime(CAST(n AS TIMESTAMP), '%Y-%m-%d %H:%M:%S.%g') WHEN typeof(n) = 'TIMESTAMP WITH TIME ZONE' THEN regexp_replace(strftime(CAST(n AS TIMESTAMPTZ), '%Y-%m-%d %H:%M:%S.%g %z') || '00', ':(\d\d)(:\d\d)?00$', '\1') WHEN typeof(n) = 'TIME' THEN strftime(DATE '1970-01-01' + CAST(n AS TIME), '%H:%M:%S') WHEN typeof(n) = 'BLOB' THEN hex(CAST(n AS BLOB)) WHEN typeof(n) LIKE '%[]' OR typeof(n) LIKE 'MAP(%' OR typeof(n) LIKE 'STRUCT(%' THEN CAST(sf_json(n) AS VARCHAR) ELSE CAST(n AS VARCHAR) END AS "TO_VARCHAR(N)", CAST(s AS DECIMAL(10,2)) AS "TO_NUMBER(S, 10, 2)" FROM t

-- SELECT CONVERT_TIMEZONE('UTC', 'America/New_York', ts), CONVERT_TIMEZONE('Europe/Paris', ts) FROM t
SELECT timezone('America/New_York', timezone('UTC', CAST(ts AS TIMESTAMP))) AS "CONVERT_TIMEZONE('UTC', 'AMERICA/NEW_YORK', TS)", timezone('Europe/Paris', CAST(ts AS TIMESTAMPTZ)) AS "CONVERT_TIMEZONE('EUROPE/PARIS', TS)" FROM t

-- SELECT TIME_SLICE(ts, 15, 'MINUTE') FROM t
SELECT sf_time_slice(ts, to_minutes(CAST(15 AS BIGINT)), '1970-01-01') AS "TIME_SLICE(TS, 15, 'MINUTE')" FROM t

-- SELECT LISTAGG(DISTINCT x, ',') WITHIN GROUP (ORDER BY x) FROM t
SELECT coalesce(string_agg(DISTINCT x, ',' ORDER BY x NULLS LAST), '') AS "LISTAGG(DISTINCT X, ',') WITHIN GROUP (ORDER BY X)" FROM t

-- SELECT ARRAY_AGG(x) WITHIN GROUP (ORDER BY y DESC) FROM t
SELECT coalesce(to_json(list(sf_to_json(x) ORDER BY y DESC NULLS FIRST) FILTER (WHERE sf_to_json(x) IS NOT NULL)), CAST('[]' AS JSON)) AS "ARRAY_AGG(X) WITHIN GROUP (ORDER BY Y DESC)" FROM t

-- SELECT OBJECT_CONSTRUCT('k', k, 'v', v), ARRAY_CONSTRUCT(1, 2) FROM t
SELECT to_json(map_from_entries(list_sort(list_filter([{'k': CAST('k' AS VARCHAR), 'v': to_json(sf_to_json(k))}, {'k': CAST('v' AS VARCHAR), 'v': to_json(sf_to_json(v))}], lambda e: e.v IS NOT NULL)))) AS "OBJECT_CONSTRUCT('K', K, 'V', V)", json_array(1, 2) AS "ARRAY_CONSTRUCT(1, 2)" FROM t

-- SELECT PARSE_JSON(s), TRY_PARSE_JSON(s) FROM t
SELECT json(s) AS "PARSE_JSON(S)", CASE WHEN json_valid(s) THEN json(s) END AS "TRY_PARSE_JSON(S)" FROM t

-- SELECT v:a.b[0]::string, v:c, v['d'] FROM t WHERE v:type = 'click' AND v:n > 5
SELECT sf_get_string(v, '$.a.b[0]') AS "V:A.B[0]::STRING", sf_get(v, '$.c') AS "V:C", sf_get(v, '$.d') AS "V['D']" FROM t WHERE sf_get_string(v, '$.type') = 'click' AND CAST(sf_get_string(v, '$.n') AS DOUBLE) > 5

-- SELECT GET(v, 'a'), GET_PATH(v, 'a.b[0]'), ARRAY_SIZE(v:items), ARRAY_CONTAINS(1::variant, arr) FROM t
SELECT sf_get(v, '$.a') AS "GET(V, 'A')", sf_get(v, '$.a.b[0]') AS "GET_PATH(V, 'A.B[0]')", CASE WHEN json_type(CAST(sf_get(v, '$.items') AS JSON)) = 'ARRAY' THEN CAST(json_array_length(CAST(sf_get(v, '$.items') AS JSON)) AS BIGINT) END AS "ARRAY_SIZE(V:ITEMS)", list_contains(CAST(CAST(sf_json(arr) AS JSON) AS JSON[]), to_json(to_json(1))) AS "ARRAY_CONTAINS(1::VARIANT, ARR)" FROM t

-- SELECT f.value:name::string, f.index FROM t, LATERAL FLATTEN(input => t.items) f
SELECT json_extract_string(f.value, '$.name') AS "F.VALUE:NAME::STRING", f.index FROM t, LATERAL (SELECT CAST(NULL AS BIGINT) AS "SEQ", _sf_flatten._sf_key AS "KEY", coalesce(CASE WHEN _sf_flatten._sf_key IS NULL THEN '[' || _sf_flatten._sf_index || ']' ELSE _sf_flatten._sf_key END, '') AS "PATH", _sf_flatten._sf_index AS "INDEX", _sf_flatten._sf_value AS "VALUE", CAST(NULL AS JSON) AS "THIS" FROM (SELECT unnest(sf_flatten_values(t.items, 'BOTH')) AS _sf_value, unnest(sf_flatten_keys(t.items, 'BOTH')) AS _sf_key, unnest(sf_flatten_indexes(t.items, 'BOTH')) AS _sf_index) AS _sf_flatten) AS "f"

-- SELECT s.value FROM TABLE(SPLIT_TO_TABLE('a,b', ',')) s
SELECT s.value FROM LATERAL (SELECT CAST(NULL AS BIGINT) AS "SEQ", _sf_i AS "INDEX", _sf_split._sf_parts[_sf_i] AS "VALUE" FROM (SELECT string_split('a,b', ',') AS _sf_parts) AS _sf_split, range(1, len(_sf_split._sf_parts) + 1) AS _sf_range(_sf_i) ORDER BY _sf_i) AS "s"

-- SELECT SPLIT(s, ','), SPLIT_PART(s, ',', 0), STRTOK(s, ' ', 2) FROM t
SELECT to_json(string_split(s, ',')) AS "SPLIT(S, ',')", split_part(s, ',', 1) AS "SPLIT_PART(S, ',', 0)", sf_tokens(s, ' ')[CAST(2 AS BIGINT)] AS "STRTOK(S, ' ', 2)" FROM t

-- SELECT REGEXP_SUBSTR(s, '[0-9]+', 1, 2), REGEXP_LIKE(s, 'a.*'), s RLIKE 'b+', REGEXP_REPLACE(s, 'a', 'b') FROM t
SELECT regexp_extract_all(s, '[0-9]+', 0)[CAST(2 AS BIGINT)] AS "REGEXP_SUBSTR(S, '[0-9]+', 1, 2)", regexp_full_match(s, 'a.*') AS "REGEXP_LIKE(S, 'A.*')", s SIMILAR TO 'b+' AS "S RLIKE 'B+'", regexp_replace(s, 'a', 'b', 'g') AS "REGEXP_REPLACE(S, 'A', 'B')" FROM t

-- SELECT CHARINDEX('b', s), POSITION('b', s), LEN(s), LEFT(s, 2), SQUARE(n) FROM t
SELECT strpos(s, 'b') AS "CHARINDEX('B', S)", strpos(s, 'b') AS "POSITION('B', S)", length(s) AS "LEN(S)", left(s, CAST(greatest(2, 0) AS INTEGER)) AS "LEFT(S, 2)", power(n, 2) AS "SQUARE(N)" FROM t

-- SELECT UNIFORM(1, 10, RANDOM()), UUID_STRING(), HASH(a) FROM t
SELECT CAST(floor(1 + random() * (10 - 1 + 1)) AS BIGINT) AS "UNIFORM(1, 10, RANDOM())", CAST(uuid() AS VARCHAR) AS "UUID_STRING()", CAST(CAST(hash(a) AS HUGEINT) - 9223372036854775808 AS BIGINT) AS "HASH(A)" FROM t
NOTICE: HASH computes DuckDB's hash, not Snowflake's: the values differ from Snowflake's, though they are as well distributed

-- SELECT MEDIAN(x), MODE(x), APPROX_COUNT_DISTINCT(x), HLL(x) FROM t
SELECT MEDIAN(x) AS "MEDIAN(X)", MODE(x) AS "MODE(X)", approx_count_distinct(x) AS "APPROX_COUNT_DISTINCT(X)", approx_count_distinct(x) AS "HLL(X)" FROM t

-- SELECT x, RATIO_TO_REPORT(x) OVER (PARTITION BY g) FROM t
SELECT x, sf_div(x, nullif(sum(x) OVER (PARTITION BY g), 0)) AS "RATIO_TO_REPORT(X) OVER (PARTITION BY G)" FROM t

-- SELECT SEQ4() FROM TABLE(GENERATOR(ROWCOUNT => 10))
SELECT (row_number() OVER () - 1) AS "SEQ4()" FROM range(CAST(10 AS BIGINT)) AS "generator"(_sf_row)

-- SELECT * FROM t SAMPLE (10) SEED (42)
SELECT * FROM t TABLESAMPLE bernoulli(10%) REPEATABLE (42)

-- SELECT * FROM t TABLESAMPLE BERNOULLI (5 ROWS)
SELECT * FROM t TABLESAMPLE reservoir(5 ROWS)

-- SELECT a FROM t MINUS SELECT a FROM u
SELECT a FROM t EXCEPT SELECT a FROM u

-- SELECT * FROM t WHERE s ILIKE ANY ('a%', 'b%')
SELECT * FROM t WHERE (s ILIKE 'a%' OR s ILIKE 'b%')

-- SELECT * FROM t QUALIFY ROW_NUMBER() OVER (PARTITION BY a ORDER BY b DESC) = 1
SELECT * FROM t QUALIFY ROW_NUMBER() OVER (PARTITION BY a ORDER BY b DESC NULLS FIRST) = 1

-- SELECT TOP 10 * FROM t ORDER BY a
SELECT * FROM t ORDER BY a NULLS LAST LIMIT 10

-- SELECT * FROM VALUES (1, 'a'), (2, 'b')
SELECT * FROM (VALUES (1, 'a'), (2, 'b')) AS _sf_values(column1, column2)

-- WITH r AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT n FROM r
WITH RECURSIVE r AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT n FROM r

-- SELECT * FROM IDENTIFIER('db.sch.tbl')
SELECT * FROM db.sch.tbl

-- SELECT AT.total, at.n, LEFT.x, gt.y, t.at, v:at.left FROM a AS AT, b AS left, c AS gt
SELECT "AT".total, "AT".n, "LEFT".x, gt.y, t.at, sf_get(v, '$.at.left') AS "V:AT.LEFT" FROM a AS "AT", b AS "LEFT", c AS gt

-- SET x = 10
SET VARIABLE "x" = 10

-- SELECT $x
SELECT getvariable('x') AS "$X"

-- UNSET x
RESET VARIABLE "x"

-- ALTER SESSION SET TIMEZONE = 'UTC'
SET TimeZone = 'UTC'

-- ALTER SESSION SET USE_CACHED_RESULT = FALSE
COMMAND: ALTER SESSION

-- USE SCHEMA analytics.marts
USE analytics.marts

-- CREATE OR REPLACE TRANSIENT TABLE t (id INT, name STRING, amount NUMBER(10,2), ts TIMESTAMP_NTZ, v VARIANT) CLUSTER BY (id) COPY GRANTS
CREATE OR REPLACE TABLE t (id BIGINT, name VARCHAR, amount DECIMAL(10,2), ts TIMESTAMP, v JSON)
AFTER: ALTER TABLE t SET SORTED BY (id)

-- CREATE OR REPLACE SECURE VIEW v COPY GRANTS COMMENT = 'x' AS SELECT 1 AS a
CREATE OR REPLACE VIEW v AS SELECT 1 AS a
NOTICE: SECURE is ignored: Igloo views run with their reader's privileges and their definitions are visible
NOTICE: COMMENT = ... is ignored; set the comment with COMMENT ON

-- ALTER TABLE t ADD COLUMN c TIMESTAMP_LTZ
ALTER TABLE t ADD COLUMN c TIMESTAMPTZ

-- SELECT x::number(10,2), y::int, z::float, w::variant, CAST(q AS TIMESTAMP_TZ) FROM t
SELECT CAST(x AS DECIMAL(10,2)) AS "X::NUMBER(10,2)", CAST(y AS BIGINT) AS "Y::INT", CAST(z AS DOUBLE) AS "Z::FLOAT", sf_to_json(w) AS "W::VARIANT", CAST(q AS TIMESTAMPTZ) AS "CAST(Q AS TIMESTAMP_TZ)" FROM t

-- SELECT 'it\'s', $$raw\string$$ // comment
SELECT 'it''s' AS "'IT\'S'", 'raw\string' AS "$$RAW\STRING$$" -- comment

-- DESC TABLE t
DESCRIBE t

-- GRANT SELECT ON TABLE t TO ROLE analyst
GRANT SELECT ON TABLE t TO analyst

-- GRANT USAGE ON WAREHOUSE wh TO ROLE analyst
COMMAND: GRANT
NOTICE: GRANT USAGE on a warehouse changes nothing: Igloo needs no USAGE grant to reach its schemas

-- SELECT * FROM t PIVOT (SUM(v) FOR k IN ('a', 'b'))
SELECT * FROM t PIVOT (SUM(v) FOR k IN ('a' AS "'a'", 'b' AS "'b'"))

-- SELECT * FROM t UNPIVOT (val FOR name IN (col_a, col_b))
SELECT * FROM t UNPIVOT (val FOR name IN (col_a AS 'COL_A', col_b AS 'COL_B'))

-- SELECT lag(x) IGNORE NULLS OVER (ORDER BY o) FROM t
SELECT lag(x IGNORE NULLS) OVER (ORDER BY o NULLS LAST) AS "LAG(X) IGNORE NULLS OVER (ORDER BY O)" FROM t

-- SELECT CONCAT(a, b), CONCAT_WS('-', a, b) FROM t
SELECT (CAST(a AS VARCHAR) || CAST(b AS VARCHAR)) AS "CONCAT(A, B)", (CAST(a AS VARCHAR) || '-' || CAST(b AS VARCHAR)) AS "CONCAT_WS('-', A, B)" FROM t

-- SELECT X'002A', HEX_ENCODE(X'0A0b', 0) FROM t
SELECT unhex('002A') AS "X'002A'", CASE WHEN 0 = 0 THEN lower(hex(unhex('0A0b'))) ELSE hex(unhex('0A0b')) END AS "HEX_ENCODE(X'0A0B', 0)" FROM t

-- SELECT PARSE_JSON(s)::VARIANT[0], s::OBJECT:a::string FROM t
SELECT json_extract(to_json(json(s)), '$[0]') AS "PARSE_JSON(S)::VARIANT[0]", json_extract_string(sf_to_json(s), '$.a') AS "S::OBJECT:A::STRING" FROM t

-- SELECT * EXCLUDE (a) REPLACE (b + 1 AS b) FROM t
SELECT * EXCLUDE (a) REPLACE (b + 1 AS b) FROM t

-- SELECT t.* ILIKE 'a%' FROM t
SELECT t.* ILIKE 'a%' FROM t

-- SELECT DATE_PART(year FROM d), EXTRACT('month', d) FROM t
SELECT date_part('year', d) AS "DATE_PART(YEAR FROM D)", date_part('month', d) AS "EXTRACT('MONTH', D)" FROM t

-- SELECT HLL(a, b), APPROX_COUNT_DISTINCT(a) FROM t
SELECT approx_count_distinct(CASE WHEN a IS NOT NULL AND b IS NOT NULL THEN (a, b) END) AS "HLL(A, B)", approx_count_distinct(a) AS "APPROX_COUNT_DISTINCT(A)" FROM t

-- SELECT TIME_FROM_PARTS(12, 34, 56, 987654321)
SELECT CAST(TIME '00:00:00' + to_microseconds(CAST(12 AS BIGINT) * 3600000000 + CAST(34 AS BIGINT) * 60000000 + CAST(56 AS BIGINT) * 1000000 + CAST(987654321 AS BIGINT) // 1000) AS TIME) AS "TIME_FROM_PARTS(12, 34, 56, 987654321)"

-- SELECT * FROM trades t ASOF JOIN quotes q MATCH_CONDITION (t.ts >= q.ts) ON t.sym = q.sym WHERE t.px > 0
SELECT * FROM trades t ASOF LEFT JOIN quotes q ON (t.ts >= q.ts) AND (t.sym = q.sym) WHERE t.px > 0

-- SELECT * FROM a INNER DIRECTED JOIN b USING (id)
SELECT * FROM a INNER JOIN b USING (id)

-- SELECT * FROM t AT (OFFSET => -60 * 5)
SELECT * FROM t AT (TIMESTAMP => current_timestamp + to_microseconds(CAST((-60 * 5) * 1000000 AS BIGINT)))

-- SELECT * FROM t BEFORE (STATEMENT => 'x')
ERROR: BEFORE (...) is not supported in Igloo's Snowflake dialect

-- SELECT * FROM @stage/file.csv
ERROR: stages (@stage) is not supported in Igloo's Snowflake dialect

-- SELECT id FROM t START WITH parent IS NULL CONNECT BY PRIOR id = parent
ERROR: CONNECT BY is not supported in Igloo's Snowflake dialect

-- SELECT * FROM a, b WHERE a.id = b.id (+)
ERROR: the (+) outer join operator is not supported in Igloo's Snowflake dialect

-- SELECT * FROM TABLE('db.s.t')
SELECT * FROM db.s.t

-- SELECT OBJECT_CONSTRUCT(*) FROM t
ERROR: OBJECT_CONSTRUCT(*) is not supported in Igloo's Snowflake dialect

-- SELECT * FROM t AT (OFFSET => -60) AS x WHERE x.a = 1
SELECT * FROM t AS x AT (TIMESTAMP => current_timestamp + to_microseconds(CAST((-60) * 1000000 AS BIGINT))) WHERE x.a = 1

-- SELECT * FROM t PIVOT (SUM(v) FOR k IN (ANY ORDER BY k))
ERROR: PIVOT ... IN (ANY) and IN (SELECT ...) is not supported in Igloo's Snowflake dialect

-- SELECT BOOLAND(a, b), BOOLXOR(a, 0), GETBIT(a, 2) FROM t
SELECT ((a <> 0) AND (b <> 0)) AS "BOOLAND(A, B)", ((a <> 0) <> (0 <> 0)) AS "BOOLXOR(A, 0)", ((a >> CAST(2 AS INTEGER)) & 1) AS "GETBIT(A, 2)" FROM t

